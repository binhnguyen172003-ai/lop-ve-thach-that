rules_version = '2';

// Luật bảo mật cho web Lớp Vẽ Không Vui.
// Dán toàn bộ nội dung file này vào Firebase Console > Firestore Database > Rules > Publish.
//
// Ba vai trò:
//   Quản lý  : Gmail trong ADMIN (bên dưới) hoặc có document admins/<gmail>. Toàn quyền.
//   Giáo viên: có document giaovien/<gmail>. Giao bài, xem tiến độ, chấm và nhận xét.
//   Học viên : có document hocvien/<gmail>. Học giáo trình, làm bài, xem nhận xét của mình.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && (
        myEmail() == 'binhnguyen172003@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(myEmail()))
      );
    }
    function isTeacher() {
      return signedIn() && exists(/databases/$(database)/documents/giaovien/$(myEmail()));
    }
    function isStaff() {
      return isAdmin() || isTeacher();
    }
    function isStudent() {
      return signedIn() && exists(/databases/$(database)/documents/hocvien/$(myEmail()));
    }
    function isMe(mail) {
      return signedIn() && myEmail() == mail;
    }
    function shortText(d, k, n) {
      return !(k in d) || (d[k] is string && d[k].size() <= n);
    }
    function hvDaDuyet(mail) {
      return exists(/databases/$(database)/documents/hocvien/$(mail));
    }
    // Học viên thuần (không kiêm giáo viên): giáo viên chỉ được vào kênh trao đổi của những người này
    function chiHocVien(mail) {
      return hvDaDuyet(mail) && !exists(/databases/$(database)/documents/giaovien/$(mail));
    }
    // Ảnh lưu dạng chữ: chỉ nhận dữ liệu ảnh thật (chặn chèn mã độc qua ảnh)
    function anhHopLe(v) {
      return v is string && v.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$');
    }
    // Link kèm bài/tin: chỉ https:// hoặc mục trong web (#...)
    function linkHopLe(d) {
      return !('link' in d) || d.link == '' || (d.link is string && d.link.size() <= 300
        && (d.link.matches('^https://[^ "<>]+$') || d.link.matches('^#[a-z0-9-]+$')));
    }
    // Tên/vai trò hiển thị trong tin nhắn phải đúng với người gửi
    function vtDung(d) {
      return !('vt' in d) || (d.vt == 'ql' && isAdmin()) || (d.vt == 'gv' && isTeacher()) || (d.vt == 'hv' && !isAdmin() && !isTeacher());
    }

    // Giáo trình: ai đã duyệt cũng đọc được; chỉ quản lý sửa.
    match /giaotrinh/{id} {
      allow read: if isStudent() || isStaff();
      allow write: if isAdmin();
    }

    // Bài tập: ai đã duyệt cũng đọc được; giáo viên và quản lý giao, sửa, xoá.
    match /baitap/{id} {
      allow read: if isStudent() || isStaff();
      allow write: if isStaff();
    }

    // Học viên đã duyệt: giáo viên xem danh sách; học viên chỉ xem hồ sơ mình; quản lý duyệt.
    match /hocvien/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow create, delete: if isAdmin();
      // Học viên tự sửa SĐT và trường thi của mình; quản lý sửa mọi thứ; giáo viên chỉ đổi tên khi quản lý/giáo viên duyệt yêu cầu
      allow update: if isAdmin()
        || (isMe(mail) && isStudent() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sdt', 'truongThi', 'khoi'])
            && shortText(request.resource.data, 'sdt', 15) && shortText(request.resource.data, 'truongThi', 20)
            && (!('khoi' in request.resource.data) || request.resource.data.khoi in ['Khối H', 'Khối V', 'Cơ bản']))
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ten'])
            && request.resource.data.ten is string && request.resource.data.ten.size() > 0 && request.resource.data.ten.size() <= 80);
    }

    // Yêu cầu đổi tên của học viên: học viên gửi cho chính mình; quản lý / giáo viên duyệt (đổi hocvien) hoặc xoá
    match /doiten/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow create: if isMe(mail) && isStudent()
        && request.resource.data.keys().hasOnly(['tenMoi', 'tenCu', 'luc'])
        && request.resource.data.tenMoi is string && request.resource.data.tenMoi.size() > 0 && request.resource.data.tenMoi.size() <= 80;
      // Gửi lại yêu cầu khi đã có một yêu cầu cũ chưa duyệt: ghi đè chính yêu cầu của mình
      allow update: if isMe(mail) && isStudent()
        && request.resource.data.keys().hasOnly(['tenMoi', 'tenCu', 'luc'])
        && request.resource.data.tenMoi is string && request.resource.data.tenMoi.size() > 0 && request.resource.data.tenMoi.size() <= 80;
      allow delete: if isStaff() || isMe(mail);
    }

    // Đơn hoạ cụ: quản lý tạo và xác nhận đã nhận tiền (kho tự trừ); học viên xem đơn của mình và báo đã chuyển khoản.
    match /dondh/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.mail == myEmail());
      allow create: if isAdmin() && request.resource.data.trangThai == 'cho'
        && request.resource.data.mail is string && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30;
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'thuLuc']))
        || (isStudent() && resource.data.mail == myEmail() && resource.data.trangThai == 'cho'
            && request.resource.data.trangThai == 'da_bao'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'baoLuc']));
      allow delete: if isAdmin();
    }

    // Giáo viên đã duyệt: chỉ quản lý xem và duyệt; giáo viên xem hồ sơ của chính mình.
    match /giaovien/{mail} {
      allow read: if isAdmin() || isMe(mail);
      allow write: if isAdmin();
    }

    // Yêu cầu duyệt: ai đăng nhập Google cũng gửi được, chỉ cho Gmail của chính mình.
    match /yeucau/{mail} {
      allow read: if isAdmin() || isMe(mail);
      allow create, update: if isMe(mail)
        && request.resource.data.gmail == mail
        && request.resource.data.vaiTro in ['hocvien', 'giaovien']
        && request.resource.data.keys().hasOnly(['vaiTro', 'gmail', 'ten', 'namSinh', 'sdt', 'sdtPh', 'truong', 'lopHoc',
             'khuVuc', 'coso', 'chuongTrinh', 'khoi', 'namThi', 'mucTieu', 'ghiChu', 'guiLuc'])
        && request.resource.data.ten is string && request.resource.data.ten.size() > 0 && request.resource.data.ten.size() <= 80
        && shortText(request.resource.data, 'sdt', 15)
        && shortText(request.resource.data, 'sdtPh', 15)
        && shortText(request.resource.data, 'truong', 80)
        && shortText(request.resource.data, 'khuVuc', 80)
        && shortText(request.resource.data, 'mucTieu', 120)
        && shortText(request.resource.data, 'ghiChu', 300)
        && (!('namSinh' in request.resource.data) || request.resource.data.namSinh is int);
      allow delete: if isAdmin();
    }

    // Tiến độ học: học viên tự ghi của mình; giáo viên và quản lý xem.
    match /tiendo/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow write: if isStudent() && isMe(mail);
    }

    // Ảnh bài học viên tải lên: học viên ghi và xem của mình; giáo viên, quản lý xem tất cả.
    match /anhbaitap/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow write: if isStudent() && isMe(mail);
    }

    // Điểm và nhận xét bài tập: giáo viên và quản lý ghi; học viên xem của mình.
    match /nhanxet/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow write: if isStaff();
    }

    // Điểm danh: giáo viên và quản lý ghi; học viên xem của mình.
    match /diemdanh/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow write: if isStaff();
    }

    // ===== KHU LÀM VIỆC =====
    // Thông báo: quản lý và giáo viên đăng; "tatca" thì học viên cũng đọc được, "giaovien" chỉ nội bộ.
    // Khung giờ nhắc cố định (ăn sáng, ăn trưa, ăn tối, nộp bài…): ai đăng nhập đều đọc; chỉ quản lý đặt
    match /lichnhac/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.ten is string && request.resource.data.ten.size() > 0 && request.resource.data.ten.size() <= 80
        && request.resource.data.gio is string && request.resource.data.gio.size() == 5
        && request.resource.data.nd is string && request.resource.data.nd.size() <= 300;
      allow delete: if isAdmin();
    }

    match /thongbao/{id} {
      allow read: if isStaff() || (isStudent() && resource.data.gui == 'tatca');
      allow create: if isStaff()
        && request.resource.data.tacGia == myEmail()
        && request.resource.data.gui in ['tatca', 'giaovien']
        && request.resource.data.nd is string && request.resource.data.nd.size() > 0 && request.resource.data.nd.size() <= 2000
        && shortText(request.resource.data, 'tieuDe', 120);
      allow delete: if isAdmin() || (isStaff() && resource.data.tacGia == myEmail());
    }

    // ===== TÁC VỤ giao cho giáo viên =====
    // Quản lý tạo, sửa, duyệt, huỷ, xoá. Giáo viên chỉ đọc việc giao cho mình hoặc cho "tatca" (tất cả giáo viên),
    // chỉ cập nhật tiến độ: Chưa bắt đầu / Đang làm / Chờ kiểm tra (Hoàn thành chỉ khi việc không cần quản lý duyệt),
    // tick các bước nhỏ, đánh dấu chú ý. Không sửa được tên, người nhận, hạn hay việc đã xong / đã huỷ.
    function giaoChoToi(d) {
      return d.get('nguoi', []).hasAny(['tatca', myEmail()]);
    }
    function tacVuHopLe(d) {
      return d.ten is string && d.ten.size() > 0 && d.ten.size() <= 200
        && d.nguoi is list && d.nguoi.size() > 0 && d.nguoi.size() <= 40
        && d.get('trangThai', 'chua') in ['chua', 'dang', 'cho', 'sua', 'xong', 'huy']
        && d.get('uuTien', 'tb') in ['thap', 'tb', 'cao', 'gap']
        && shortText(d, 'moTa', 3000) && shortText(d, 'coSo', 20) && shortText(d, 'han', 10) && shortText(d, 'ngayGiao', 10)
        && (!('buoc' in d) || (d.buoc is list && d.buoc.size() <= 20))
        && (!('anh' in d) || (d.anh is list && d.anh.size() <= 3))
        && linkHopLe(d);
    }
    match /congviec/{id} {
      allow read: if isAdmin() || (isTeacher() && giaoChoToi(resource.data));
      allow create: if isAdmin() && tacVuHopLe(request.resource.data);
      allow delete: if isAdmin();
      allow update: if (isAdmin() && tacVuHopLe(request.resource.data))
        || (isTeacher() && giaoChoToi(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'buoc', 'chuY', 'soBl', 'capNhat', 'capNhatBoi', 'batDau', 'nopLuc', 'xong', 'xongLuc', 'xongBoi'])
          && resource.data.get('trangThai', 'chua') in ['chua', 'dang', 'sua', 'cho']
          && (request.resource.data.get('trangThai', 'chua') in ['chua', 'dang', 'cho']
            || (request.resource.data.trangThai == 'xong' && resource.data.get('canDuyet', false) == false))
          && request.resource.data.get('xong', false) == (request.resource.data.get('trangThai', 'chua') == 'xong')
          && request.resource.data.get('buoc', []).size() == resource.data.get('buoc', []).size());
      // Trao đổi + lịch sử đổi trạng thái của từng việc: chỉ ghi thêm, không sửa
      match /bl/{bid} {
        allow read: if isAdmin() || (isTeacher() && giaoChoToi(get(/databases/$(database)/documents/congviec/$(id)).data));
        allow create: if (isAdmin() || (isTeacher() && giaoChoToi(get(/databases/$(database)/documents/congviec/$(id)).data)))
          && request.resource.data.tu == myEmail() && request.resource.data.loai in ['bl', 'tt']
          && request.resource.data.luc is int && shortText(request.resource.data, 'nd', 1000);
        allow delete: if isAdmin();
      }
    }

    // Trao đổi riêng: mỗi học viên / giáo viên có một kênh mang Gmail của mình.
    //   Kênh học viên : học viên đó + giáo viên + quản lý.   Kênh giáo viên: giáo viên đó + quản lý.
    match /traodoi/{kenh} {
      allow read: if isAdmin() || isMe(kenh) || (isTeacher() && resource.data.vaiTro == 'hocvien');
      allow create, update: if isAdmin()
        || (isMe(kenh) && isStudent() && !isTeacher() && request.resource.data.vaiTro == 'hocvien')
        || (isMe(kenh) && isTeacher() && !isAdmin() && request.resource.data.vaiTro == 'giaovien')
        || (isTeacher() && request.resource.data.vaiTro == 'hocvien' && chiHocVien(kenh));
      allow delete: if isAdmin();
      match /tin/{id} {
        allow read: if isAdmin() || isMe(kenh) || (isTeacher() && chiHocVien(kenh));
        allow create: if (isAdmin() || (isMe(kenh) && (isStudent() || isTeacher())) || (isTeacher() && chiHocVien(kenh)))
          && request.resource.data.tu == myEmail() && vtDung(request.resource.data)
          && request.resource.data.nd is string && request.resource.data.nd.size() > 0 && request.resource.data.nd.size() <= 1000;
        allow delete: if isAdmin();
      }
    }

    // ===== HẠNG & THÀNH TỰU: anh chị cộng XP / trao thành tựu; ai cũng xem (hiện ở Top rank) =====
    match /xephang/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['hocVien', 'loai', 'xp', 'ma', 'ghiChu', 'luc', 'nguoi'])
        && request.resource.data.hocVien is string && request.resource.data.hocVien.size() > 0 && request.resource.data.hocVien.size() <= 80
        && request.resource.data.loai in ['xp', 'thanhtuu']
        && (!('xp' in request.resource.data) || (request.resource.data.xp is int && request.resource.data.xp > 0 && request.resource.data.xp <= 2000))
        && shortText(request.resource.data, 'ghiChu', 120);
      allow delete: if isAdmin();
    }

    // ===== KHO HOẠ CỤ: chỉ quản lý xem và ghi (nhập hàng, bán hàng, tồn kho) =====
    match /kho/{id} {
      allow read, write: if isAdmin();
    }
    match /khogd/{id} {
      allow read, write: if isAdmin();
    }

    // ===== ẢNH ĐẠI DIỆN: mỗi tài khoản một ảnh riêng (ảnh đã thu nhỏ, lưu dạng chữ) =====
    match /anhdaidien/{mail} {
      allow get: if signedIn();
      allow list: if isStaff();
      allow write: if isMe(mail)
        && request.resource.data.keys().hasOnly(['anh', 'luc'])
        && request.resource.data.anh is string && request.resource.data.anh.size() <= 200000;
    }

    // ===== BÀI VẼ HỌC VIÊN: giáo viên + quản lý đăng; CHỈ quản lý chọn Top 1–5; ai cũng xem =====
    match /baive/{id} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.data.nguoi == myEmail()
        && request.resource.data.anh is string && request.resource.data.anh.size() <= 950000
        && request.resource.data.hocVien is string && request.resource.data.hocVien.size() > 0 && request.resource.data.hocVien.size() <= 80
        && request.resource.data.loai in ['Cơ bản', 'Hình hoạ người', 'Tượng', 'Màu', 'Mỹ thuật 2', 'Tĩnh vật', 'Bút sắt', 'Mực nho', 'Màu nước']
        && shortText(request.resource.data, 'ghiChu', 120) && shortText(request.resource.data, 'link', 300) && linkHopLe(request.resource.data)
        && (isAdmin() || (request.resource.data.hang == 0 && !('mau' in request.resource.data && request.resource.data.mau == true)));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hang', 'ngayTop'])
        && request.resource.data.hang is int && request.resource.data.hang >= 0 && request.resource.data.hang <= 5;
      // Quản lý sửa thông tin bài (tên, loại, mô tả, người vẽ, ảnh…); không đổi người đăng, ngày đăng hay hạng Top
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hocVien', 'loai', 'ghiChu', 'link', 'moTa', 'chucVu', 'biDanh', 'gvhd', 'tgiang', 'mau', 'anh'])
        && request.resource.data.hocVien is string && request.resource.data.hocVien.size() > 0 && request.resource.data.hocVien.size() <= 80
        && request.resource.data.anh is string && request.resource.data.anh.size() <= 950000
        && shortText(request.resource.data, 'ghiChu', 120) && shortText(request.resource.data, 'link', 300) && linkHopLe(request.resource.data)
        && shortText(request.resource.data, 'moTa', 300) && shortText(request.resource.data, 'biDanh', 30)
        && shortText(request.resource.data, 'gvhd', 80) && shortText(request.resource.data, 'tgiang', 80);
      allow delete: if isAdmin() || (isStaff() && resource.data.nguoi == myEmail());
    }

    // ===== BẢN TIN NỔI BẬT: giáo viên + quản lý đăng; quản lý ghim; ai cũng xem =====
    match /bantin/{id} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.data.tacGia == myEmail()
        && request.resource.data.muc in ['tuyensinh', 'tinlop', 'hoacu', 'lythuyet', 'kinhnghiem']
        && request.resource.data.tieuDe is string && request.resource.data.tieuDe.size() > 0 && request.resource.data.tieuDe.size() <= 120
        && request.resource.data.nd is string && request.resource.data.nd.size() > 0 && request.resource.data.nd.size() <= 3000
        && shortText(request.resource.data, 'link', 300) && linkHopLe(request.resource.data)
        && (!('anh' in request.resource.data) || (request.resource.data.anh is string && request.resource.data.anh.size() <= 500000))
        && (isAdmin() || request.resource.data.ghim == false);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ghim']);
      // Quản lý sửa nội dung tin (chuyên mục, tiêu đề, nội dung, ảnh, link, ghim); không đổi người đăng
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['muc', 'tieuDe', 'nd', 'anh', 'link', 'ghim'])
        && request.resource.data.muc in ['tuyensinh', 'tinlop', 'hoacu', 'lythuyet', 'kinhnghiem']
        && request.resource.data.tieuDe is string && request.resource.data.tieuDe.size() > 0 && request.resource.data.tieuDe.size() <= 120
        && request.resource.data.nd is string && request.resource.data.nd.size() > 0 && request.resource.data.nd.size() <= 3000
        && shortText(request.resource.data, 'link', 300) && linkHopLe(request.resource.data)
        && (!('anh' in request.resource.data) || (request.resource.data.anh is string && request.resource.data.anh.size() <= 500000));
      allow delete: if isAdmin() || (isStaff() && resource.data.tacGia == myEmail());
    }

    // ===== Thi thử =====
    // Đề: học viên đã duyệt và anh chị đọc; giáo viên/quản lý tạo, sửa; xoá: người tạo hoặc quản lý.
    match /thithu/{id} {
      allow read: if isStudent() || isStaff();
      allow create, update: if isStaff()
        && (request.method == 'create' ? request.resource.data.nguoi == myEmail()
            : (isAdmin() || resource.data.nguoi == myEmail()) && request.resource.data.nguoi == resource.data.nguoi)
        && request.resource.data.tieuDe is string && request.resource.data.tieuDe.size() > 0 && request.resource.data.tieuDe.size() <= 120
        && request.resource.data.phut is int && request.resource.data.phut >= 5 && request.resource.data.phut <= 600
        && request.resource.data.moTu is number && request.resource.data.dongLuc is number
        && request.resource.data.tieuChi is list && request.resource.data.tieuChi.size() > 0 && request.resource.data.tieuChi.size() <= 10
        && shortText(request.resource.data, 'deBai', 4000)
        && (!('anhDe' in request.resource.data) || request.resource.data.anhDe == ''
            || (anhHopLe(request.resource.data.anhDe) && request.resource.data.anhDe.size() <= 500000));
      allow delete: if isAdmin() || (isStaff() && resource.data.nguoi == myEmail());
    }
    // Bài thi: mã = <mã đề>__<gmail>. Học viên bắt đầu (giờ bắt đầu do máy chủ đối chiếu), nộp một lần; anh chị chấm.
    match /thithubai/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.mail == myEmail());
      allow create: if isStudent()
        && request.resource.data.mail == myEmail()
        && id == request.resource.data.thi + '__' + myEmail()
        && exists(/databases/$(database)/documents/thithu/$(request.resource.data.thi))
        && request.resource.data.keys().hasOnly(['thi', 'mail', 'ten', 'batDau'])
        && request.resource.data.batDau is int
        && request.resource.data.batDau > request.time.toMillis() - 120000
        && request.resource.data.batDau < request.time.toMillis() + 120000;
      allow update: if (isStudent() && resource.data.mail == myEmail() && !('nop' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nop', 'anh', 'ghiChu'])
          && request.resource.data.nop is int
          && request.resource.data.nop > request.time.toMillis() - 120000
          && request.resource.data.nop < request.time.toMillis() + 120000
          && request.resource.data.anh is list && request.resource.data.anh.size() > 0 && request.resource.data.anh.size() <= 2
          && anhHopLe(request.resource.data.anh[0]) && (request.resource.data.anh.size() < 2 || anhHopLe(request.resource.data.anh[1]))
          && shortText(request.resource.data, 'ghiChu', 500))
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cham']));
      allow delete: if isAdmin();
    }

    // ===== Ca dạy, đổi ca, bàn giao =====
    match /caday/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
      // giáo viên tự vô ca / kết ca cho ca của mình: mỗi mốc ghi một lần, giờ phải sát giờ máy chủ (±5 phút) để không khai khống
      // "ddXong": anh chị dạy ca xác nhận đã xong điểm danh học viên (một lần)
      allow update: if isStaff() && resource.data.gv == myEmail()
        && (vaoRaHopLe('vao') && !('vao' in resource.data)
          || vaoRaHopLe('ra') && ('vao' in resource.data) && !('ra' in resource.data)
          || vaoRaHopLe('ddXong') && !('ddXong' in resource.data));
    }
    // Báo sai giờ chấm công: giáo viên gửi cho ca của mình; chỉ quản lý duyệt (duyệt mới sửa giờ trong caday)
    match /suacong/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.tu == myEmail());
      allow create: if isStaff() && request.resource.data.tu == myEmail() && request.resource.data.trangThai == 'cho'
        && request.resource.data.ca is string
        && get(/databases/$(database)/documents/caday/$(request.resource.data.ca)).data.gv == myEmail()
        && request.resource.data.lyDo is string && request.resource.data.lyDo.size() > 0 && request.resource.data.lyDo.size() <= 300
        && shortText(request.resource.data, 'vao', 5) && shortText(request.resource.data, 'ra', 5);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'xuLy', 'xuLyLuc'])
        && request.resource.data.trangThai in ['dongy', 'tuchoi'];
      allow delete: if isAdmin() || (isStaff() && resource.data.tu == myEmail() && resource.data.trangThai == 'cho');
    }
    // Thưởng / khấu trừ lương: chỉ quản lý tạo (có lý do); giáo viên chỉ xem khoản của mình
    match /luongdc/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.gv == myEmail());
      allow create: if isAdmin() && request.resource.data.loai in ['thuong', 'tru']
        && request.resource.data.gv is string && request.resource.data.thang is string && request.resource.data.thang.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.tien is int && request.resource.data.tien > 0 && request.resource.data.tien <= 100000000
        && request.resource.data.lyDo is string && request.resource.data.lyDo.size() > 0 && request.resource.data.lyDo.size() <= 300
        && shortText(request.resource.data, 'muc', 60);
      allow update: if false;
      allow delete: if isAdmin();
    }
    // Bảng lương đã chốt theo tháng: quản lý chốt / mở lại; giáo viên chỉ xem bảng của mình
    match /bangluong/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.gv == myEmail());
      allow write: if isAdmin();
    }
    function vaoRaHopLe(k) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([k])
        && request.resource.data[k] is int
        && math.abs(request.resource.data[k] - request.time.toMillis()) < 300000;
    }
    match /doica/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.tu == myEmail());
      allow create: if isStaff() && request.resource.data.tu == myEmail() && request.resource.data.trangThai == 'cho'
        && shortText(request.resource.data, 'lyDo', 500) && shortText(request.resource.data, 'thay', 80);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'xuLy', 'xuLyLuc'])
        && request.resource.data.trangThai in ['dongy', 'tuchoi'];
      allow delete: if isAdmin() || (isStaff() && resource.data.tu == myEmail() && resource.data.trangThai == 'cho');
    }
    match /bangiao/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.ai == myEmail()
        && request.resource.data.hv is list && request.resource.data.hv.size() > 0 && request.resource.data.hv.size() <= 40
        && shortText(request.resource.data, 'ghiChu', 1000);
      allow delete: if isAdmin() || (isStaff() && resource.data.ai == myEmail());
    }

    // ===== Báo thiếu đồ, sự cố =====
    // Học viên đã duyệt và anh chị gửi; người gửi xem báo cáo của mình; quản lý cập nhật trạng thái.
    match /suco/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.ai == myEmail());
      allow create: if (isStaff() || isStudent()) && request.resource.data.ai == myEmail() && request.resource.data.trangThai == 'moi'
        && request.resource.data.moTa is string && request.resource.data.moTa.size() > 0 && request.resource.data.moTa.size() <= 1000
        && (!('anh' in request.resource.data) || (anhHopLe(request.resource.data.anh) && request.resource.data.anh.size() <= 400000));
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'capNhat', 'xuLy', 'phanHoi'])
        && request.resource.data.trangThai in ['moi', 'danhan', 'dangxuly', 'xong'] && shortText(request.resource.data, 'phanHoi', 500);
      allow delete: if isAdmin();
    }

    // ===== Trực nhật & kiểm tra cuối buổi =====
    match /trucnhat/{coSo} {
      allow read: if isStudent() || isStaff();
      allow write: if isStaff();
    }
    match /kiemtra/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && request.resource.data.ai == myEmail() && shortText(request.resource.data, 'ghiChu', 300);
      allow delete: if isAdmin();
    }

    // ===== Nhật ký sửa: chỉ ghi thêm, không ai sửa/xoá được; quản lý đọc để khôi phục =====
    match /nhatky/{id} {
      allow read: if isAdmin();
      allow create: if isStaff() && request.resource.data.ai == myEmail() && request.resource.data.luc is int
        && request.resource.data.col in ['hocvien', 'giaovien', 'nhanxet', 'diemdanh', 'baitap', 'giaotrinh', 'lichnhac', 'tiendo', 'xephang', 'baive', 'bantin', 'kho',
             'thongbao', 'congviec', 'doiten', 'caday', 'trucnhat', 'thithu', 'thithubai', 'suco', 'bangiao', 'kiemtra', 'doica',
             'luongdc', 'bangluong', 'suacong']
        && request.resource.data.loai in ['tao', 'sua', 'xoa'] && request.resource.data.ma is string
        // Giáo viên không được tạo / xoá hồ sơ ở các bảng chỉ quản lý thao tác → nhật ký kiểu đó chắc chắn là giả
        && (isAdmin() || request.resource.data.loai == 'sua'
            || !(request.resource.data.col in ['hocvien', 'giaovien', 'caday', 'kho', 'xephang', 'giaotrinh', 'lichnhac', 'tiendo', 'luongdc', 'bangluong']));
      allow update, delete: if false;
    }

    // Cấu hình chung do quản lý sửa trên web (hiện có: thời gian biểu các cơ sở). Ai cũng đọc được để hiện lịch học.
    match /cauhinh/{id} {
      allow read: if true;
      allow write: if isAdmin() && id == 'thoigianbieu'
        && request.resource.data.keys().hasOnly(['tkb', 'luc', 'nguoi'])
        && request.resource.data.tkb is map && request.resource.data.tkb.size() <= 10
        && request.resource.data.nguoi == myEmail();
    }
    match /admins/{mail} {
      allow read: if isMe(mail);
      allow write: if false;
    }
  }
}
