rules_version = '2';

// Luật bảo mật cho web Lớp Vẽ Không Vui.
// Dán toàn bộ nội dung file này vào Firebase Console > Firestore Database > Rules > Publish.
//
// Ba vai trò:
//   Quản lý  : Gmail trong ADMIN (bên dưới) hoặc có document admins/<gmail>. Toàn quyền.
//   Giáo viên: có document giaovien/<gmail>. Giao bài, xem tiến độ, chấm và nhận xét.
//   Học viên : có document hocvien/<gmail>. Học giáo trình, làm bài, xem nhận xét của mình.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && (
        myEmail() == 'binhnguyen172003@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(myEmail()))
      );
    }
    function isTeacher() {
      return signedIn() && exists(/databases/$(database)/documents/giaovien/$(myEmail()));
    }
    function isStaff() {
      return isAdmin() || isTeacher();
    }
    function isStudent() {
      return signedIn() && exists(/databases/$(database)/documents/hocvien/$(myEmail()));
    }
    function isMe(mail) {
      return signedIn() && myEmail() == mail;
    }
    function shortText(d, k, n) {
      return !(k in d) || (d[k] is string && d[k].size() <= n);
    }
    function hvDaDuyet(mail) {
      return exists(/databases/$(database)/documents/hocvien/$(mail));
    }

    // Giáo trình: ai đã duyệt cũng đọc được; chỉ quản lý sửa.
    match /giaotrinh/{id} {
      allow read: if isStudent() || isStaff();
      allow write: if isAdmin();
    }

    // Bài tập: ai đã duyệt cũng đọc được; giáo viên và quản lý giao, sửa, xoá.
    match /baitap/{id} {
      allow read: if isStudent() || isStaff();
      allow write: if isStaff();
    }

    // Học viên đã duyệt: giáo viên xem danh sách; học viên chỉ xem hồ sơ mình; quản lý duyệt.
    match /hocvien/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow write: if isAdmin();
    }

    // Giáo viên đã duyệt: chỉ quản lý xem và duyệt; giáo viên xem hồ sơ của chính mình.
    match /giaovien/{mail} {
      allow read: if isAdmin() || isMe(mail);
      allow write: if isAdmin();
    }

    // Yêu cầu duyệt: ai đăng nhập Google cũng gửi được, chỉ cho Gmail của chính mình.
    match /yeucau/{mail} {
      allow read: if isAdmin() || isMe(mail);
      allow create, update: if isMe(mail)
        && request.resource.data.gmail == mail
        && request.resource.data.vaiTro in ['hocvien', 'giaovien']
        && request.resource.data.keys().hasOnly(['vaiTro', 'gmail', 'ten', 'namSinh', 'sdt', 'sdtPh', 'truong', 'lopHoc',
             'khuVuc', 'coso', 'chuongTrinh', 'khoi', 'namThi', 'mucTieu', 'ghiChu', 'guiLuc'])
        && request.resource.data.ten is string && request.resource.data.ten.size() > 0 && request.resource.data.ten.size() <= 80
        && shortText(request.resource.data, 'sdt', 15)
        && shortText(request.resource.data, 'sdtPh', 15)
        && shortText(request.resource.data, 'truong', 80)
        && shortText(request.resource.data, 'khuVuc', 80)
        && shortText(request.resource.data, 'mucTieu', 120)
        && shortText(request.resource.data, 'ghiChu', 300)
        && (!('namSinh' in request.resource.data) || request.resource.data.namSinh is int);
      allow delete: if isAdmin();
    }

    // Tiến độ học: học viên tự ghi của mình; giáo viên và quản lý xem.
    match /tiendo/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow write: if isStudent() && isMe(mail);
    }

    // Điểm và nhận xét bài tập: giáo viên và quản lý ghi; học viên xem của mình.
    match /nhanxet/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow write: if isStaff();
    }

    // Điểm danh: giáo viên và quản lý ghi; học viên xem của mình.
    match /diemdanh/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow write: if isStaff();
    }

    // ===== KHU LÀM VIỆC =====
    // Thông báo: quản lý và giáo viên đăng; "tatca" thì học viên cũng đọc được, "giaovien" chỉ nội bộ.
    match /thongbao/{id} {
      allow read: if isStaff() || (isStudent() && resource.data.gui == 'tatca');
      allow create: if isStaff()
        && request.resource.data.tacGia == myEmail()
        && request.resource.data.gui in ['tatca', 'giaovien']
        && request.resource.data.nd is string && request.resource.data.nd.size() > 0 && request.resource.data.nd.size() <= 2000
        && shortText(request.resource.data, 'tieuDe', 120);
      allow delete: if isAdmin() || (isStaff() && resource.data.tacGia == myEmail());
    }

    // Việc giao cho giáo viên: quản lý giao và xoá; giáo viên chỉ được đánh dấu xong.
    match /congviec/{id} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isTeacher()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xong', 'xongLuc', 'xongBoi']));
    }

    // Trao đổi riêng: mỗi học viên / giáo viên có một kênh mang Gmail của mình.
    //   Kênh học viên : học viên đó + giáo viên + quản lý.   Kênh giáo viên: giáo viên đó + quản lý.
    match /traodoi/{kenh} {
      allow read: if isAdmin() || isMe(kenh) || (isTeacher() && resource.data.vaiTro == 'hocvien');
      allow create, update: if isAdmin()
        || (isMe(kenh) && isStudent() && !isTeacher() && request.resource.data.vaiTro == 'hocvien')
        || (isMe(kenh) && isTeacher() && !isAdmin() && request.resource.data.vaiTro == 'giaovien')
        || (isTeacher() && request.resource.data.vaiTro == 'hocvien' && hvDaDuyet(kenh));
      allow delete: if isAdmin();
      match /tin/{id} {
        allow read: if isAdmin() || isMe(kenh) || (isTeacher() && hvDaDuyet(kenh));
        allow create: if (isAdmin() || (isMe(kenh) && (isStudent() || isTeacher())) || (isTeacher() && hvDaDuyet(kenh)))
          && request.resource.data.tu == myEmail()
          && request.resource.data.nd is string && request.resource.data.nd.size() > 0 && request.resource.data.nd.size() <= 1000;
        allow delete: if isAdmin();
      }
    }

    // ===== HẠNG & THÀNH TỰU: thầy cô cộng XP / trao thành tựu; ai cũng xem (hiện ở Top rank) =====
    match /xephang/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['hocVien', 'loai', 'xp', 'ma', 'ghiChu', 'luc', 'nguoi'])
        && request.resource.data.hocVien is string && request.resource.data.hocVien.size() > 0 && request.resource.data.hocVien.size() <= 80
        && request.resource.data.loai in ['xp', 'thanhtuu']
        && (!('xp' in request.resource.data) || (request.resource.data.xp is int && request.resource.data.xp > 0 && request.resource.data.xp <= 2000))
        && shortText(request.resource.data, 'ghiChu', 120);
      allow delete: if isAdmin();
    }

    // ===== KHO HOẠ CỤ: chỉ quản lý xem và ghi (nhập hàng, bán hàng, tồn kho) =====
    match /kho/{id} {
      allow read, write: if isAdmin();
    }
    match /khogd/{id} {
      allow read, write: if isAdmin();
    }

    // ===== ẢNH ĐẠI DIỆN: mỗi tài khoản một ảnh riêng (ảnh đã thu nhỏ, lưu dạng chữ) =====
    match /anhdaidien/{mail} {
      allow get: if signedIn();
      allow list: if isStaff();
      allow write: if isMe(mail)
        && request.resource.data.keys().hasOnly(['anh', 'luc'])
        && request.resource.data.anh is string && request.resource.data.anh.size() <= 200000;
    }

    // ===== BÀI VẼ HỌC VIÊN: giáo viên + quản lý đăng; CHỈ quản lý chọn Top 1–5; ai cũng xem =====
    match /baive/{id} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.data.nguoi == myEmail()
        && request.resource.data.anh is string && request.resource.data.anh.size() <= 950000
        && request.resource.data.hocVien is string && request.resource.data.hocVien.size() > 0 && request.resource.data.hocVien.size() <= 80
        && request.resource.data.loai in ['Cơ bản', 'Hình hoạ người', 'Tượng', 'Màu', 'Mỹ thuật 2']
        && shortText(request.resource.data, 'ghiChu', 120) && shortText(request.resource.data, 'link', 300)
        && (isAdmin() || request.resource.data.hang == 0);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hang', 'ngayTop'])
        && request.resource.data.hang is int && request.resource.data.hang >= 0 && request.resource.data.hang <= 5;
      allow delete: if isAdmin() || (isStaff() && resource.data.nguoi == myEmail());
    }

    // ===== BẢN TIN NỔI BẬT: giáo viên + quản lý đăng; quản lý ghim; ai cũng xem =====
    match /bantin/{id} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.data.tacGia == myEmail()
        && request.resource.data.muc in ['hoacu', 'lythuyet', 'kinhnghiem', 'tinlop']
        && request.resource.data.tieuDe is string && request.resource.data.tieuDe.size() > 0 && request.resource.data.tieuDe.size() <= 120
        && request.resource.data.nd is string && request.resource.data.nd.size() > 0 && request.resource.data.nd.size() <= 3000
        && shortText(request.resource.data, 'link', 300)
        && (!('anh' in request.resource.data) || (request.resource.data.anh is string && request.resource.data.anh.size() <= 500000))
        && (isAdmin() || request.resource.data.ghim == false);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ghim']);
      allow delete: if isAdmin() || (isStaff() && resource.data.tacGia == myEmail());
    }

    match /admins/{mail} {
      allow read: if isMe(mail);
      allow write: if false;
    }
  }
}
