rules_version = '2';

// Luật bảo mật cho web Lớp Vẽ Không Vui.
// Dán toàn bộ nội dung file này vào Firebase Console > Firestore Database > Rules > Publish.
//
// Ba vai trò:
//   Quản lý  : Gmail trong ADMIN (bên dưới) hoặc có document admins/<gmail>. Toàn quyền.
//   Giáo viên: có document giaovien/<gmail>. Giao bài, xem tiến độ, chấm và nhận xét.
//   Học viên : có document hocvien/<gmail>. Học giáo trình, làm bài, xem nhận xét của mình.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && (
        myEmail() == 'binhnguyen172003@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(myEmail()))
      );
    }
    // Giáo viên bị khoá trong Phân quyền hệ thống (phanquyen.khoa) mất toàn bộ quyền nội bộ
    function isTeacher() {
      return signedIn() && exists(/databases/$(database)/documents/giaovien/$(myEmail())) && khongKhoa();
    }
    function isStaff() {
      return isAdmin() || isTeacher();
    }
    function isStudent() {
      return signedIn() && exists(/databases/$(database)/documents/hocvien/$(myEmail()));
    }
    function isMe(mail) {
      return signedIn() && myEmail() == mail;
    }
    function shortText(d, k, n) {
      return !(k in d) || (d[k] is string && d[k].size() <= n);
    }
    function hvDaDuyet(mail) {
      return exists(/databases/$(database)/documents/hocvien/$(mail));
    }
    // Học viên thuần (không kiêm giáo viên): giáo viên chỉ được vào kênh trao đổi của những người này
    function chiHocVien(mail) {
      return hvDaDuyet(mail) && !exists(/databases/$(database)/documents/giaovien/$(mail));
    }
    // Ảnh lưu dạng chữ: chỉ nhận dữ liệu ảnh thật (chặn chèn mã độc qua ảnh)
    function anhHopLe(v) {
      return v is string && v.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$');
    }
    // Link kèm bài/tin: chỉ https:// hoặc mục trong web (#...)
    function linkHopLe(d) {
      return !('link' in d) || d.link == '' || (d.link is string && d.link.size() <= 300
        && (d.link.matches('^https://[^ "<>]+$') || d.link.matches('^#[a-z0-9-]+$')));
    }
    // Tên/vai trò hiển thị trong tin nhắn phải đúng với người gửi
    function vtDung(d) {
      return !('vt' in d) || (d.vt == 'ql' && isAdmin()) || (d.vt == 'gv' && isTeacher()) || (d.vt == 'hv' && !isAdmin() && !isTeacher());
    }

    // Giáo trình: ai đã duyệt cũng đọc được; chỉ quản lý sửa.
    match /giaotrinh/{id} {
      allow read: if isStudent() || isStaff();
      allow write: if isAdmin();
    }

    // Bài tập: ai đã duyệt cũng đọc được; giáo viên và quản lý giao, sửa, xoá.
    match /baitap/{id} {
      allow read: if isStudent() || isStaff();
      allow write: if isStaff();
    }

    // Học viên đã duyệt: giáo viên xem danh sách; học viên chỉ xem hồ sơ mình; quản lý duyệt.
    match /hocvien/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow create, delete: if isAdmin();
      // Học viên tự sửa SĐT và trường thi của mình; quản lý sửa mọi thứ; giáo viên chỉ đổi tên khi quản lý/giáo viên duyệt yêu cầu
      allow update: if isAdmin()
        || (isMe(mail) && isStudent() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sdt', 'truongThi', 'khoi'])
            && shortText(request.resource.data, 'sdt', 15) && shortText(request.resource.data, 'truongThi', 20)
            && (!('khoi' in request.resource.data) || request.resource.data.khoi in ['Khối H', 'Khối V', 'Cơ bản']))
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ten'])
            && request.resource.data.ten is string && request.resource.data.ten.size() > 0 && request.resource.data.ten.size() <= 80);
    }

    // Yêu cầu đổi tên của học viên: học viên gửi cho chính mình; quản lý / giáo viên duyệt (đổi hocvien) hoặc xoá
    match /doiten/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow create: if isMe(mail) && isStudent()
        && request.resource.data.keys().hasOnly(['tenMoi', 'tenCu', 'luc'])
        && request.resource.data.tenMoi is string && request.resource.data.tenMoi.size() > 0 && request.resource.data.tenMoi.size() <= 80;
      // Gửi lại yêu cầu khi đã có một yêu cầu cũ chưa duyệt: ghi đè chính yêu cầu của mình
      allow update: if isMe(mail) && isStudent()
        && request.resource.data.keys().hasOnly(['tenMoi', 'tenCu', 'luc'])
        && request.resource.data.tenMoi is string && request.resource.data.tenMoi.size() > 0 && request.resource.data.tenMoi.size() <= 80;
      allow delete: if isStaff() || isMe(mail);
    }

    // Đơn hoạ cụ: quản lý tạo và xác nhận đã nhận tiền (kho tự trừ); học viên xem đơn của mình và báo đã chuyển khoản.
    match /dondh/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.mail == myEmail());
      allow create: if isAdmin() && request.resource.data.trangThai == 'cho'
        && request.resource.data.mail is string && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30;
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'thuLuc']))
        || (isStudent() && resource.data.mail == myEmail() && resource.data.trangThai == 'cho'
            && request.resource.data.trangThai == 'da_bao'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'baoLuc']));
      allow delete: if isAdmin();
    }

    // Giáo viên đã duyệt: chỉ quản lý xem và duyệt; giáo viên xem hồ sơ của chính mình.
    match /giaovien/{mail} {
      allow read: if isAdmin() || isMe(mail);
      allow write: if isAdmin();
    }

    // Yêu cầu duyệt: ai đăng nhập Google cũng gửi được, chỉ cho Gmail của chính mình.
    match /yeucau/{mail} {
      allow read: if isAdmin() || isMe(mail);
      allow create, update: if isMe(mail)
        && request.resource.data.gmail == mail
        && request.resource.data.vaiTro in ['hocvien', 'giaovien']
        && request.resource.data.keys().hasOnly(['vaiTro', 'gmail', 'ten', 'namSinh', 'sdt', 'sdtPh', 'truong', 'lopHoc',
             'khuVuc', 'coso', 'chuongTrinh', 'khoi', 'namThi', 'mucTieu', 'ghiChu', 'guiLuc'])
        && request.resource.data.ten is string && request.resource.data.ten.size() > 0 && request.resource.data.ten.size() <= 80
        && shortText(request.resource.data, 'sdt', 15)
        && shortText(request.resource.data, 'sdtPh', 15)
        && shortText(request.resource.data, 'truong', 80)
        && shortText(request.resource.data, 'khuVuc', 80)
        && shortText(request.resource.data, 'mucTieu', 120)
        && shortText(request.resource.data, 'ghiChu', 300)
        && (!('namSinh' in request.resource.data) || request.resource.data.namSinh is int);
      allow delete: if isAdmin();
    }

    // Tiến độ học: học viên tự ghi của mình; giáo viên và quản lý xem.
    match /tiendo/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow write: if isStudent() && isMe(mail);
    }

    // Ảnh bài học viên tải lên: học viên ghi và xem của mình; giáo viên, quản lý xem tất cả.
    match /anhbaitap/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow write: if isStudent() && isMe(mail);
    }

    // Điểm và nhận xét bài tập: giáo viên và quản lý ghi; học viên xem của mình.
    match /nhanxet/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow write: if isStaff();
    }

    // Điểm danh: giáo viên và quản lý ghi; học viên xem của mình.
    match /diemdanh/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow write: if isStaff();
    }

    // ===== KHU LÀM VIỆC =====
    // Thông báo: quản lý và giáo viên đăng; "tatca" thì học viên cũng đọc được, "giaovien" chỉ nội bộ.
    // Khung giờ nhắc cố định (ăn sáng, ăn trưa, ăn tối, nộp bài…): ai đăng nhập đều đọc; chỉ quản lý đặt
    match /lichnhac/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.ten is string && request.resource.data.ten.size() > 0 && request.resource.data.ten.size() <= 80
        && request.resource.data.gio is string && request.resource.data.gio.size() == 5
        && request.resource.data.nd is string && request.resource.data.nd.size() <= 300;
      allow delete: if isAdmin();
    }

    match /thongbao/{id} {
      allow read: if isStaff() || (isStudent() && resource.data.gui == 'tatca');
      allow create: if isStaff()
        && request.resource.data.tacGia == myEmail()
        && request.resource.data.gui in ['tatca', 'giaovien']
        && request.resource.data.nd is string && request.resource.data.nd.size() > 0 && request.resource.data.nd.size() <= 2000
        && shortText(request.resource.data, 'tieuDe', 120);
      allow delete: if isAdmin() || (isStaff() && resource.data.tacGia == myEmail());
    }

    // ===== TÁC VỤ giao cho giáo viên =====
    // Quản lý tạo, sửa, duyệt, huỷ, xoá. Giáo viên chỉ đọc việc giao cho mình hoặc cho "tatca" (tất cả giáo viên),
    // chỉ cập nhật tiến độ: Chưa bắt đầu / Đang làm / Chờ kiểm tra (Hoàn thành chỉ khi việc không cần quản lý duyệt),
    // tick các bước nhỏ, đánh dấu chú ý. Không sửa được tên, người nhận, hạn hay việc đã xong / đã huỷ.
    function giaoChoToi(d) {
      return d.get('nguoi', []).hasAny(['tatca', myEmail()]);
    }
    function tacVuHopLe(d) {
      return d.ten is string && d.ten.size() > 0 && d.ten.size() <= 200
        && d.nguoi is list && d.nguoi.size() > 0 && d.nguoi.size() <= 40
        && d.get('trangThai', 'chua') in ['chua', 'dang', 'cho', 'sua', 'xong', 'huy']
        && d.get('uuTien', 'tb') in ['thap', 'tb', 'cao', 'gap']
        && shortText(d, 'moTa', 3000) && shortText(d, 'coSo', 20) && shortText(d, 'han', 10) && shortText(d, 'ngayGiao', 10)
        && (!('buoc' in d) || (d.buoc is list && d.buoc.size() <= 20))
        && (!('anh' in d) || (d.anh is list && d.anh.size() <= 3))
        && linkHopLe(d);
    }
    match /congviec/{id} {
      allow read: if isAdmin() || (isTeacher() && giaoChoToi(resource.data));
      allow create: if isAdmin() && tacVuHopLe(request.resource.data);
      allow delete: if isAdmin();
      allow update: if (isAdmin() && tacVuHopLe(request.resource.data))
        || (isTeacher() && giaoChoToi(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'buoc', 'chuY', 'soBl', 'capNhat', 'capNhatBoi', 'batDau', 'nopLuc', 'xong', 'xongLuc', 'xongBoi'])
          && resource.data.get('trangThai', 'chua') in ['chua', 'dang', 'sua', 'cho']
          && (request.resource.data.get('trangThai', 'chua') in ['chua', 'dang', 'cho']
            || (request.resource.data.trangThai == 'xong' && resource.data.get('canDuyet', false) == false))
          && request.resource.data.get('xong', false) == (request.resource.data.get('trangThai', 'chua') == 'xong')
          && request.resource.data.get('buoc', []).size() == resource.data.get('buoc', []).size());
      // Trao đổi + lịch sử đổi trạng thái của từng việc: chỉ ghi thêm, không sửa
      match /bl/{bid} {
        allow read: if isAdmin() || (isTeacher() && giaoChoToi(get(/databases/$(database)/documents/congviec/$(id)).data));
        allow create: if (isAdmin() || (isTeacher() && giaoChoToi(get(/databases/$(database)/documents/congviec/$(id)).data)))
          && request.resource.data.tu == myEmail() && request.resource.data.loai in ['bl', 'tt']
          && request.resource.data.luc is int && shortText(request.resource.data, 'nd', 1000);
        allow delete: if isAdmin();
      }
    }

    // Trao đổi riêng: mỗi học viên / giáo viên có một kênh mang Gmail của mình.
    //   Kênh học viên : học viên đó + giáo viên + quản lý.   Kênh giáo viên: giáo viên đó + quản lý.
    match /traodoi/{kenh} {
      allow read: if isAdmin() || isMe(kenh) || (isTeacher() && resource.data.vaiTro == 'hocvien');
      allow create, update: if isAdmin()
        || (isMe(kenh) && isStudent() && !isTeacher() && request.resource.data.vaiTro == 'hocvien')
        || (isMe(kenh) && isTeacher() && !isAdmin() && request.resource.data.vaiTro == 'giaovien')
        || (isTeacher() && request.resource.data.vaiTro == 'hocvien' && chiHocVien(kenh));
      allow delete: if isAdmin();
      match /tin/{id} {
        allow read: if isAdmin() || isMe(kenh) || (isTeacher() && chiHocVien(kenh));
        allow create: if (isAdmin() || (isMe(kenh) && (isStudent() || isTeacher())) || (isTeacher() && chiHocVien(kenh)))
          && request.resource.data.tu == myEmail() && vtDung(request.resource.data)
          && request.resource.data.nd is string && request.resource.data.nd.size() > 0 && request.resource.data.nd.size() <= 1000;
        allow delete: if isAdmin();
      }
    }

    // ===== HẠNG & THÀNH TỰU: anh chị cộng XP / trao thành tựu; ai cũng xem (hiện ở Top rank) =====
    match /xephang/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['hocVien', 'loai', 'xp', 'ma', 'ghiChu', 'luc', 'nguoi'])
        && request.resource.data.hocVien is string && request.resource.data.hocVien.size() > 0 && request.resource.data.hocVien.size() <= 80
        && request.resource.data.loai in ['xp', 'thanhtuu']
        && (!('xp' in request.resource.data) || (request.resource.data.xp is int && request.resource.data.xp > 0 && request.resource.data.xp <= 2000))
        && shortText(request.resource.data, 'ghiChu', 120);
      allow delete: if isAdmin();
    }

    // ===== KHO HOẠ CỤ: chỉ quản lý xem và ghi (nhập hàng, bán hàng, tồn kho) =====
    match /kho/{id} {
      allow read, write: if isAdmin();
    }
    match /khogd/{id} {
      allow read, write: if isAdmin();
    }

    // ===== ẢNH ĐẠI DIỆN: mỗi tài khoản một ảnh riêng (ảnh đã thu nhỏ, lưu dạng chữ) =====
    match /anhdaidien/{mail} {
      allow get: if signedIn();
      allow list: if isStaff();
      allow write: if isMe(mail)
        && request.resource.data.keys().hasOnly(['anh', 'luc'])
        && request.resource.data.anh is string && request.resource.data.anh.size() <= 200000;
    }

    // ===== BÀI VẼ HỌC VIÊN: giáo viên + quản lý đăng; CHỈ quản lý chọn Top 1–5; ai cũng xem =====
    match /baive/{id} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.data.nguoi == myEmail()
        && request.resource.data.anh is string && request.resource.data.anh.size() <= 950000
        && request.resource.data.hocVien is string && request.resource.data.hocVien.size() > 0 && request.resource.data.hocVien.size() <= 80
        && request.resource.data.loai in ['Cơ bản', 'Hình hoạ người', 'Tượng', 'Màu', 'Mỹ thuật 2', 'Tĩnh vật', 'Bút sắt', 'Mực nho', 'Màu nước']
        && shortText(request.resource.data, 'ghiChu', 120) && shortText(request.resource.data, 'link', 300) && linkHopLe(request.resource.data)
        && (isAdmin() || (request.resource.data.hang == 0 && !('mau' in request.resource.data && request.resource.data.mau == true)));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hang', 'ngayTop'])
        && request.resource.data.hang is int && request.resource.data.hang >= 0 && request.resource.data.hang <= 5;
      // Quản lý sửa thông tin bài (tên, loại, mô tả, người vẽ, ảnh…); không đổi người đăng, ngày đăng hay hạng Top
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hocVien', 'loai', 'ghiChu', 'link', 'moTa', 'chucVu', 'biDanh', 'gvhd', 'tgiang', 'mau', 'anh'])
        && request.resource.data.hocVien is string && request.resource.data.hocVien.size() > 0 && request.resource.data.hocVien.size() <= 80
        && request.resource.data.anh is string && request.resource.data.anh.size() <= 950000
        && shortText(request.resource.data, 'ghiChu', 120) && shortText(request.resource.data, 'link', 300) && linkHopLe(request.resource.data)
        && shortText(request.resource.data, 'moTa', 300) && shortText(request.resource.data, 'biDanh', 30)
        && shortText(request.resource.data, 'gvhd', 80) && shortText(request.resource.data, 'tgiang', 80);
      allow delete: if isAdmin() || (isStaff() && resource.data.nguoi == myEmail());
    }

    // ===== BẢN TIN NỔI BẬT: giáo viên + quản lý đăng; quản lý ghim; ai cũng xem =====
    match /bantin/{id} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.data.tacGia == myEmail()
        && request.resource.data.muc in ['tuyensinh', 'tinlop', 'hoacu', 'lythuyet', 'kinhnghiem']
        && request.resource.data.tieuDe is string && request.resource.data.tieuDe.size() > 0 && request.resource.data.tieuDe.size() <= 120
        && request.resource.data.nd is string && request.resource.data.nd.size() > 0 && request.resource.data.nd.size() <= 3000
        && shortText(request.resource.data, 'link', 300) && linkHopLe(request.resource.data)
        && (!('anh' in request.resource.data) || (request.resource.data.anh is string && request.resource.data.anh.size() <= 500000))
        && (isAdmin() || request.resource.data.ghim == false);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ghim']);
      // Quản lý sửa nội dung tin (chuyên mục, tiêu đề, nội dung, ảnh, link, ghim); không đổi người đăng
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['muc', 'tieuDe', 'nd', 'anh', 'link', 'ghim'])
        && request.resource.data.muc in ['tuyensinh', 'tinlop', 'hoacu', 'lythuyet', 'kinhnghiem']
        && request.resource.data.tieuDe is string && request.resource.data.tieuDe.size() > 0 && request.resource.data.tieuDe.size() <= 120
        && request.resource.data.nd is string && request.resource.data.nd.size() > 0 && request.resource.data.nd.size() <= 3000
        && shortText(request.resource.data, 'link', 300) && linkHopLe(request.resource.data)
        && (!('anh' in request.resource.data) || (request.resource.data.anh is string && request.resource.data.anh.size() <= 500000));
      allow delete: if isAdmin() || (isStaff() && resource.data.tacGia == myEmail());
    }

    // ===== Thi thử =====
    // Đề: học viên đã duyệt và anh chị đọc; giáo viên/quản lý tạo, sửa; xoá: người tạo hoặc quản lý.
    match /thithu/{id} {
      allow read: if isStudent() || isStaff();
      allow create, update: if isStaff()
        && (request.method == 'create' ? request.resource.data.nguoi == myEmail()
            : (isAdmin() || resource.data.nguoi == myEmail()) && request.resource.data.nguoi == resource.data.nguoi)
        && request.resource.data.tieuDe is string && request.resource.data.tieuDe.size() > 0 && request.resource.data.tieuDe.size() <= 120
        && request.resource.data.phut is int && request.resource.data.phut >= 5 && request.resource.data.phut <= 600
        && request.resource.data.moTu is number && request.resource.data.dongLuc is number
        && request.resource.data.tieuChi is list && request.resource.data.tieuChi.size() > 0 && request.resource.data.tieuChi.size() <= 10
        && shortText(request.resource.data, 'deBai', 4000)
        && (!('anhDe' in request.resource.data) || request.resource.data.anhDe == ''
            || (anhHopLe(request.resource.data.anhDe) && request.resource.data.anhDe.size() <= 500000));
      allow delete: if isAdmin() || (isStaff() && resource.data.nguoi == myEmail());
    }
    // Bài thi: mã = <mã đề>__<gmail>. Học viên bắt đầu (giờ bắt đầu do máy chủ đối chiếu), nộp một lần; anh chị chấm.
    match /thithubai/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.mail == myEmail());
      allow create: if isStudent()
        && request.resource.data.mail == myEmail()
        && id == request.resource.data.thi + '__' + myEmail()
        && exists(/databases/$(database)/documents/thithu/$(request.resource.data.thi))
        && request.resource.data.keys().hasOnly(['thi', 'mail', 'ten', 'batDau'])
        && request.resource.data.batDau is int
        && request.resource.data.batDau > request.time.toMillis() - 120000
        && request.resource.data.batDau < request.time.toMillis() + 120000;
      allow update: if (isStudent() && resource.data.mail == myEmail() && !('nop' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nop', 'anh', 'ghiChu'])
          && request.resource.data.nop is int
          && request.resource.data.nop > request.time.toMillis() - 120000
          && request.resource.data.nop < request.time.toMillis() + 120000
          && request.resource.data.anh is list && request.resource.data.anh.size() > 0 && request.resource.data.anh.size() <= 2
          && anhHopLe(request.resource.data.anh[0]) && (request.resource.data.anh.size() < 2 || anhHopLe(request.resource.data.anh[1]))
          && shortText(request.resource.data, 'ghiChu', 500))
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cham']));
      allow delete: if isAdmin();
    }

    // ===== Ca dạy, đổi ca, bàn giao =====
    match /caday/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
      // giáo viên tự vô ca / kết ca cho ca của mình: mỗi mốc ghi một lần, giờ phải sát giờ máy chủ (±5 phút) để không khai khống
      // "ddXong": anh chị dạy ca xác nhận đã xong điểm danh học viên (một lần)
      allow update: if isStaff() && resource.data.gv == myEmail()
        && (vaoRaHopLe('vao') && !('vao' in resource.data)
          || vaoRaHopLe('ra') && ('vao' in resource.data) && !('ra' in resource.data)
          || vaoRaHopLe('ddXong') && !('ddXong' in resource.data));
    }
    // Báo sai giờ chấm công: giáo viên gửi cho ca của mình; chỉ quản lý duyệt (duyệt mới sửa giờ trong caday)
    match /suacong/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.tu == myEmail());
      allow create: if isStaff() && request.resource.data.tu == myEmail() && request.resource.data.trangThai == 'cho'
        && request.resource.data.ca is string
        && get(/databases/$(database)/documents/caday/$(request.resource.data.ca)).data.gv == myEmail()
        && request.resource.data.lyDo is string && request.resource.data.lyDo.size() > 0 && request.resource.data.lyDo.size() <= 300
        && shortText(request.resource.data, 'vao', 5) && shortText(request.resource.data, 'ra', 5);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'xuLy', 'xuLyLuc'])
        && request.resource.data.trangThai in ['dongy', 'tuchoi'];
      allow delete: if isAdmin() || (isStaff() && resource.data.tu == myEmail() && resource.data.trangThai == 'cho');
    }
    // Thưởng / khấu trừ lương: chỉ quản lý tạo (có lý do); giáo viên chỉ xem khoản của mình
    match /luongdc/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.gv == myEmail());
      allow create: if isAdmin() && request.resource.data.loai in ['thuong', 'tru']
        && request.resource.data.gv is string && request.resource.data.thang is string && request.resource.data.thang.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.tien is int && request.resource.data.tien > 0 && request.resource.data.tien <= 100000000
        && request.resource.data.lyDo is string && request.resource.data.lyDo.size() > 0 && request.resource.data.lyDo.size() <= 300
        && shortText(request.resource.data, 'muc', 60);
      allow update: if false;
      allow delete: if isAdmin();
    }
    // Bảng lương đã chốt theo tháng: quản lý chốt / mở lại; giáo viên chỉ xem bảng của mình
    match /bangluong/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.gv == myEmail());
      allow write: if isAdmin();
    }
    function vaoRaHopLe(k) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([k])
        && request.resource.data[k] is int
        && math.abs(request.resource.data[k] - request.time.toMillis()) < 300000;
    }
    match /doica/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.tu == myEmail());
      allow create: if isStaff() && request.resource.data.tu == myEmail() && request.resource.data.trangThai == 'cho'
        && shortText(request.resource.data, 'lyDo', 500) && shortText(request.resource.data, 'thay', 80);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'xuLy', 'xuLyLuc'])
        && request.resource.data.trangThai in ['dongy', 'tuchoi'];
      allow delete: if isAdmin() || (isStaff() && resource.data.tu == myEmail() && resource.data.trangThai == 'cho');
    }
    match /bangiao/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.ai == myEmail()
        && request.resource.data.hv is list && request.resource.data.hv.size() > 0 && request.resource.data.hv.size() <= 40
        && shortText(request.resource.data, 'ghiChu', 1000);
      allow delete: if isAdmin() || (isStaff() && resource.data.ai == myEmail());
    }

    // ===== Báo thiếu đồ, sự cố =====
    // Học viên đã duyệt và anh chị gửi; người gửi xem báo cáo của mình; quản lý cập nhật trạng thái.
    match /suco/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.ai == myEmail());
      allow create: if (isStaff() || isStudent()) && request.resource.data.ai == myEmail() && request.resource.data.trangThai == 'moi'
        && request.resource.data.moTa is string && request.resource.data.moTa.size() > 0 && request.resource.data.moTa.size() <= 1000
        && (!('anh' in request.resource.data) || (anhHopLe(request.resource.data.anh) && request.resource.data.anh.size() <= 400000));
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'capNhat', 'xuLy', 'phanHoi'])
        && request.resource.data.trangThai in ['moi', 'danhan', 'dangxuly', 'xong'] && shortText(request.resource.data, 'phanHoi', 500);
      allow delete: if isAdmin();
    }

    // ===== Trực nhật & kiểm tra cuối buổi =====
    match /trucnhat/{coSo} {
      allow read: if isStudent() || isStaff();
      allow write: if isStaff();
    }
    match /kiemtra/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && request.resource.data.ai == myEmail() && shortText(request.resource.data, 'ghiChu', 300);
      allow delete: if isAdmin();
    }

    // ===== Nhật ký sửa: chỉ ghi thêm, không ai sửa/xoá được; quản lý đọc để khôi phục =====
    match /nhatky/{id} {
      allow read: if isAdmin();
      allow create: if isStaff() && request.resource.data.ai == myEmail() && request.resource.data.luc is int
        && request.resource.data.col in ['hocvien', 'giaovien', 'nhanxet', 'diemdanh', 'baitap', 'giaotrinh', 'lichnhac', 'tiendo', 'xephang', 'baive', 'bantin', 'kho',
             'thongbao', 'congviec', 'doiten', 'caday', 'trucnhat', 'thithu', 'thithubai', 'suco', 'bangiao', 'kiemtra', 'doica',
             'luongdc', 'bangluong', 'suacong']
        && request.resource.data.loai in ['tao', 'sua', 'xoa'] && request.resource.data.ma is string
        // Giáo viên không được tạo / xoá hồ sơ ở các bảng chỉ quản lý thao tác → nhật ký kiểu đó chắc chắn là giả
        && (isAdmin() || request.resource.data.loai == 'sua'
            || !(request.resource.data.col in ['hocvien', 'giaovien', 'caday', 'kho', 'xephang', 'giaotrinh', 'lichnhac', 'tiendo', 'luongdc', 'bangluong']));
      allow update, delete: if false;
    }

    // ===== PHÂN QUYỀN NỘI DUNG: Video YouTube · Ebook Canva · Giáo trình · Khoá học =====
    // Tách 4 vai: người tạo / người phê duyệt (APPROVE) / người xuất bản (PUBLISH) / người quản lý quyền xem (MANAGE_ACCESS).
    // Thứ tự xét quyền (dừng ngay ở mức đầu tiên bị từ chối):
    //   1. Bảo mật: chưa đăng nhập, tài khoản bị khoá (phanquyen.khoa), quyền bị cấm rõ ràng (cam), quyền hết hạn (het), tự duyệt.
    //   2. Vai trò: Quản lý (toàn quyền trừ tự duyệt) · Quản lý cơ sở (qlcs: kế thừa VIEW/CREATE/EDIT) · Giáo viên (gv: không kế thừa gì).
    //   3. Cơ sở: phanquyen.coSo; tài liệu "chung" cần cả hai cơ sở. Quyền tài liệu chỉ vượt cơ sở khi có cờ vuot (uỷ quyền đặc biệt).
    //   4–6. Khoá quyền: "<loại>|<danh mục>|<cơ sở>" (danh mục / cơ sở được ghi * = tất cả) và "doc:<mã tài liệu>".
    //   7. Hành động: VIEW CREATE EDIT SOURCE(thay link nguồn) APPROVE REVOKE(thu hồi duyệt) PUBLISH MANAGE_ACCESS ARCHIVE RESTORE DELETE.
    //   8. Trạng thái: nhap → cho → duyet / sua / tuchoi; chỉ bản đã duyệt mới được xuất bản sang thuvien.
    // Cấm (cam) luôn thắng cho phép (a). Quyền có hạn (het, mili giây) tự hết hiệu lực theo giờ máy chủ.
    function pqCua(mail) {
      return get(/databases/$(database)/documents/phanquyen/$(mail)).data;
    }
    function khongKhoa() {
      return !exists(/databases/$(database)/documents/phanquyen/$(myEmail())) || pqCua(myEmail()).get('khoa', false) != true;
    }
    // Quyền còn hạn ở một mục cấp quyền g
    function aK(g) {
      return g.get('het', 0) == 0 || request.time.toMillis() < g.get('het', 0) ? g.get('a', []) : [];
    }
    function trongCs(p, cs) {
      return cs == 'chung' ? p.coSo.hasAll(['Bình Phú', 'Kim Quan']) : p.coSo.hasAny([cs]);
    }
    // Danh sách hành động thực sự được phép = (kế thừa vai trò + cấp riêng còn hạn, trong cơ sở) − mọi quyền bị cấm.
    // gd = mục cấp riêng của tài liệu ({} khi xét danh sách theo phạm vi)
    function dsQ(p, l, dm, cs, gd) {
      let c = p.cap;
      let g1 = c.get(l + '|' + dm + '|' + cs, {});
      let g2 = c.get(l + '|' + dm + '|*', {});
      let g3 = c.get(l + '|*|' + cs, {});
      let g4 = c.get(l + '|*|*', {});
      let tc = trongCs(p, cs);
      let cho = (tc ? aK(g1).concat(aK(g2)).concat(aK(g3)).concat(aK(g4)).concat(p.get('vaiTro', 'gv') == 'qlcs' ? ['VIEW', 'CREATE', 'EDIT'] : []) : [])
        .concat(tc || gd.get('vuot', false) == true ? aK(gd) : []);
      return p.get('khoa', false) == true ? []
        : cho.removeAll(g1.get('cam', []).concat(g2.get('cam', [])).concat(g3.get('cam', [])).concat(g4.get('cam', [])).concat(gd.get('cam', [])));
    }
    function laQL(mail) {
      return mail == 'binhnguyen172003@gmail.com' || exists(/databases/$(database)/documents/admins/$(mail));
    }
    // Quyền của một Gmail bất kỳ (dùng cả để kiểm tra lại người đã lên lịch xuất bản tại thời điểm xuất bản)
    function quyenCua(mail, l, dm, cs, id) {
      return laQL(mail) ? ['VIEW', 'CREATE', 'EDIT', 'SOURCE', 'APPROVE', 'REVOKE', 'PUBLISH', 'MANAGE_ACCESS', 'ARCHIVE', 'RESTORE', 'DELETE']
        : exists(/databases/$(database)/documents/giaovien/$(mail)) && exists(/databases/$(database)/documents/phanquyen/$(mail))
          ? dsCua(pqCua(mail), l, dm, cs, id) : [];
    }
    function dsCua(p, l, dm, cs, id) {
      return dsQ(p, l, dm, cs, p.cap.get('doc:' + id, {}));
    }
    function quyenToi(l, dm, cs, id) {
      return signedIn() ? quyenCua(myEmail(), l, dm, cs, id) : [];
    }

    // Bảng quyền từng tài khoản nhân sự: chỉ quản lý cấp / sửa / thu hồi; mỗi lần đổi bắt buộc kèm một dòng lịch sử.
    match /phanquyen/{mail} {
      allow read: if isAdmin() || isMe(mail);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['khoa', 'vaiTro', 'coSo', 'cap', 'camXem', 'capNhat', 'capNhatBoi', 'hdMa', 'ghiChu'])
        && request.resource.data.khoa is bool && request.resource.data.vaiTro in ['gv', 'qlcs']
        && request.resource.data.coSo is list && request.resource.data.coSo.hasOnly(['Bình Phú', 'Kim Quan'])
        && request.resource.data.cap is map && request.resource.data.cap.size() <= 80
        && request.resource.data.get('camXem', []) is list && request.resource.data.get('camXem', []).size() <= 10
        && request.resource.data.capNhatBoi == myEmail() && request.resource.data.capNhat is int
        && (resource == null || request.resource.data.hdMa != resource.data.hdMa)
        && existsAfter(/databases/$(database)/documents/phanquyen/$(mail)/ls/$(request.resource.data.hdMa));
      allow delete: if false;
      match /ls/{lid} {
        allow read: if isAdmin();
        allow create: if isAdmin() && request.resource.data.ai == myEmail() && request.resource.data.luc is int
          && request.resource.data.hd in ['cap', 'sua', 'thuhoi', 'khoa', 'mokhoa']
          && request.resource.data.noi is string && request.resource.data.noi.size() <= 6000
          && getAfter(/databases/$(database)/documents/phanquyen/$(mail)).data.hdMa == lid;
        allow update, delete: if false;
      }
    }

    function nguonHopLe(l, u) {
      return u is string && u.size() <= 500 && (
        (l == 'video' && u.matches('^https://(www[.]|m[.])?(youtube[.]com/(watch[?]v=|embed/|shorts/|live/)|youtu[.]be/)[A-Za-z0-9_-]{6,}[^ "<>]*$'))
        || (l == 'ebook' && u.matches('^https://(www[.])?canva[.](com|link)/[^ "<>]+$'))
        || (l in ['giaotrinh', 'khoahoc'] && (u == '' || u.matches('^https://[^ "<>]+$'))));
    }
    function ndHopLe(d, id) {
      return d.keys().hasOnly(['ma', 'loai', 'dm', 'cs', 'tacGia', 'tieuDe', 'moTa', 'nguon', 'ban', 'nguoi', 'lq', 'tt', 'duyet', 'luuTru',
          'nx', 'nxBoi', 'nxLuc', 'suaLuc', 'guiLuc', 'taoLuc', 'hd', 'hdBoi', 'hdLuc', 'hdMa'])
        && d.ma == id && d.loai in ['video', 'ebook', 'giaotrinh', 'khoahoc'] && d.cs in ['Bình Phú', 'Kim Quan', 'chung']
        && d.dm in ['Hình hoạ cơ bản', 'Hình hoạ người', 'Hình hoạ tượng', 'Màu & bố cục màu', 'Mỹ thuật 2', 'Ôn thi cấp tốc', 'Chung']
        && d.tieuDe is string && d.tieuDe.size() > 0 && d.tieuDe.size() <= 150
        && d.moTa is string && d.moTa.size() <= 2000 && nguonHopLe(d.loai, d.nguon)
        && d.ban is int && d.nguoi is list && d.nguoi.size() <= 20 && d.lq is list && d.lq.size() <= 40
        && d.tt in ['nhap', 'cho', 'duyet', 'sua', 'tuchoi'] && d.luuTru is bool && shortText(d, 'nx', 500)
        && d.hdBoi == myEmail() && d.hdLuc is int && d.hdMa is string && d.hdMa.size() <= 60
        && existsAfter(/databases/$(database)/documents/noidung/$(id)/ls/$(d.hdMa));
    }
    function tvAn(id) {
      return !existsAfter(/databases/$(database)/documents/thuvien/$(id))
        || getAfter(/databases/$(database)/documents/thuvien/$(id)).data.hien == false;
    }
    function chiDoi(ks) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(ks.concat(['hd', 'hdBoi', 'hdLuc', 'hdMa']));
    }
    // Toàn bộ điều kiện cập nhật kho nội dung; q = danh sách quyền thực tế của người ghi trên tài liệu này (tính một lần)
    function capNhatND(o, n, id, q) {
      let me = myEmail();
      let goc = o.tt == 'duyet' ? [] : o.nguoi;
      return ndHopLe(n, id) && n.hdMa != o.hdMa && n.loai == o.loai && n.dm == o.dm && n.cs == o.cs && n.tacGia == o.tacGia && (
        // Sửa nội dung: luôn quay về bản nháp, không đụng tới bản đã duyệt / đang xuất bản. Sửa sau khi đã gửi duyệt → phiên bản mới.
        (n.hd == 'sua' && o.luuTru == false && n.tt == 'nhap'
          && chiDoi(['tieuDe', 'moTa', 'nguon', 'ban', 'nguoi', 'lq', 'tt', 'suaLuc'])
          && ('EDIT' in q || (o.tacGia == me && 'CREATE' in q))
          // Thay link YouTube / Canva cần quyền SOURCE riêng (tác giả được đổi link khi bài chưa từng được duyệt)
          && (n.nguon == o.nguon || 'SOURCE' in q || (o.tacGia == me && o.duyet == null && 'CREATE' in q))
          && n.ban == (o.tt == 'nhap' ? o.ban : o.ban + 1)
          && n.nguoi.hasAny([me]) && n.nguoi.hasAll(goc) && n.nguoi.hasOnly(goc.concat([me]))
          && n.lq.hasAll(o.lq) && n.lq.hasOnly(o.lq.concat([me])))
        // Gửi duyệt
        || (n.hd == 'gui' && o.luuTru == false && o.tt in ['nhap', 'sua', 'tuchoi'] && n.tt == 'cho' && chiDoi(['tt', 'guiLuc'])
          && ('EDIT' in q || (o.nguoi.hasAny([me]) && 'CREATE' in q)))
        // Phê duyệt: không được duyệt phiên bản mình tạo / sửa; bản duyệt phải trùng đúng nội dung đang chờ
        || (n.hd == 'duyet' && o.luuTru == false && o.tt == 'cho' && !o.nguoi.hasAny([me]) && 'APPROVE' in q
          && n.tt == 'duyet' && chiDoi(['tt', 'duyet', 'nx', 'nxBoi', 'nxLuc'])
          && n.duyet == {'ban': o.ban, 'tieuDe': o.tieuDe, 'moTa': o.moTa, 'nguon': o.nguon, 'boi': me, 'luc': n.hdLuc})
        // Yêu cầu sửa / từ chối: bắt buộc ghi lý do
        || (n.hd in ['yeucausua', 'tuchoi'] && o.luuTru == false && o.tt == 'cho' && !o.nguoi.hasAny([me]) && 'APPROVE' in q
          && n.tt == (n.hd == 'tuchoi' ? 'tuchoi' : 'sua') && chiDoi(['tt', 'nx', 'nxBoi', 'nxLuc']) && n.get('nx', '').size() > 0)
        // Thu hồi phê duyệt: bản xuất bản liên quan phải bị ẩn trong cùng một lần ghi
        || (n.hd == 'thuhoi' && o.duyet != null && 'REVOKE' in q && n.duyet == null && n.tt == (o.tt == 'duyet' ? 'sua' : o.tt)
          && chiDoi(['duyet', 'tt', 'nx', 'nxBoi', 'nxLuc']) && n.get('nx', '').size() > 0 && tvAn(id))
        // Lưu trữ (phải ẩn khỏi thư viện) / khôi phục
        || (n.hd == 'luutru' && o.luuTru == false && n.luuTru == true && 'ARCHIVE' in q && chiDoi(['luuTru']) && tvAn(id))
        || (n.hd == 'khoiphuc' && o.luuTru == true && n.luuTru == false && 'RESTORE' in q && chiDoi(['luuTru']))
        );
    }
    // Thao tác xuất bản: tài liệu chỉ ghi dấu lịch sử; quyền được xét ở thuvien (ghi cùng mã hdMa trong cùng lần ghi)
    function dauXB(o, n, id) {
      return ndHopLe(n, id) && n.hdMa != o.hdMa && chiDoi([])
        && existsAfter(/databases/$(database)/documents/thuvien/$(id))
        && getAfter(/databases/$(database)/documents/thuvien/$(id)).data.hdMa == n.hdMa;
    }
    function taoND(n, id, q) {
      return 'CREATE' in q && ndHopLe(n, id) && n.hd == 'tao' && n.tacGia == myEmail() && n.nguoi == [myEmail()] && n.lq == [myEmail()]
        && n.ban == 1 && n.tt == 'nhap' && n.duyet == null && n.luuTru == false;
    }
    function xemND(d, id, q) {
      return isAdmin() || 'VIEW' in q || (isTeacher() && d.lq.hasAny([myEmail()]));
    }

    // Kho nội dung (bản nháp → chờ duyệt → đã duyệt). Học viên không đọc được; học viên chỉ đọc bản đã xuất bản trong thuvien.
    match /noidung/{id} {
      // Đọc lẻ: xét đủ 8 mức. Đọc danh sách: không xét được khoá "doc:<mã>" nên tài liệu bị cấm xem riêng
      // phải được loại khỏi truy vấn bằng where('ma', 'not-in', phanquyen.camXem) (tối đa 10 tài liệu).
      allow get: if xemND(resource.data, id, quyenToi(resource.data.loai, resource.data.dm, resource.data.cs, id));
      allow list: if isAdmin();
      allow list: if isTeacher() && resource.data.lq.hasAny([myEmail()]);
      allow list: if isTeacher() && exists(/databases/$(database)/documents/phanquyen/$(myEmail()))
        && 'VIEW' in dsQ(pqCua(myEmail()), resource.data.loai, resource.data.dm, resource.data.cs, {})
        && (pqCua(myEmail()).get('camXem', []).size() == 0 || !(resource.data.ma in pqCua(myEmail()).get('camXem', [])));
      allow create: if taoND(request.resource.data, id,
        quyenToi(request.resource.data.loai, request.resource.data.dm, request.resource.data.cs, id));
      allow update: if request.resource.data.hd in ['xuatban', 'lichxb', 'an', 'phamvi', 'kichhoat'] ? dauXB(resource.data, request.resource.data, id)
        : capNhatND(resource.data, request.resource.data, id, quyenToi(resource.data.loai, resource.data.dm, resource.data.cs, id));
      allow delete: if 'DELETE' in quyenToi(resource.data.loai, resource.data.dm, resource.data.cs, id) && resource.data.luuTru == true
        && (!exists(/databases/$(database)/documents/thuvien/$(id)) || get(/databases/$(database)/documents/thuvien/$(id)).data.hien == false);
      // Lịch sử từng tài liệu: ai làm gì, lúc nào, phiên bản nào. Chỉ ghi thêm, gắn đúng với lần ghi tài liệu.
      match /ls/{lid} {
        allow read: if lsXem(get(/databases/$(database)/documents/noidung/$(id)).data, id);
        allow create: if lsHopLe(request.resource.data, getAfter(/databases/$(database)/documents/noidung/$(id)).data, lid);
        allow update, delete: if false;
      }
    }
    function lsXem(d, id) {
      return xemND(d, id, quyenToi(d.loai, d.dm, d.cs, id));
    }
    function lsHopLe(n, nd, lid) {
      return signedIn() && n.keys().hasOnly(['ai', 'luc', 'hd', 'ban', 'nx', 'tieuDe'])
        && n.ai == myEmail() && n.luc is int && shortText(n, 'nx', 500) && shortText(n, 'tieuDe', 150)
        && nd.hdMa == lid && nd.hd == n.hd && nd.hdBoi == myEmail() && n.ban == nd.ban;
    }

    function phamViMacDinh(cs) {
      return cs == 'chung' ? 'tatca' : cs;
    }
    function phamViHopLe(pv, cs) {
      return cs == 'chung' ? pv in ['tatca', 'Bình Phú', 'Kim Quan'] : pv == cs;
    }
    // Xuất bản ngay / lên lịch: cần PUBLISH; phạm vi khác mặc định cần thêm MANAGE_ACCESS.
    // Bản đưa cho học viên phải sao y bản đã duyệt hiện hành (không lấy bản nháp mới đang chờ duyệt).
    function xuatBanTV(o, n, nd, q) {
      return n.hd in ['xuatban', 'lichxb'] && (o == null || n.hdMa != o.hdMa) && 'PUBLISH' in q
        && (n.phamVi == phamViMacDinh(nd.cs) || 'MANAGE_ACCESS' in q)
        && nd.duyet != null && nd.luuTru == false
        && n.keys().hasOnly(['loai', 'dm', 'cs', 'ban', 'tieuDe', 'moTa', 'nguon', 'duyetBoi', 'phamVi', 'hien', 'tu', 'xbBoi', 'xbLuc', 'lyDo', 'hd', 'hdBoi', 'hdLuc', 'hdMa'])
        && n.ban == nd.duyet.ban && n.tieuDe == nd.duyet.tieuDe && n.moTa == nd.duyet.moTa && n.nguon == nd.duyet.nguon
        && n.duyetBoi == nd.duyet.boi && n.loai == nd.loai && n.dm == nd.dm && n.cs == nd.cs
        && phamViHopLe(n.phamVi, nd.cs) && n.tu is int && n.xbBoi == myEmail() && n.xbLuc is int
        && n.hdBoi == myEmail() && n.hdMa == nd.hdMa && n.hd == nd.hd
        && ((n.hd == 'xuatban' && n.hien == true && n.tu <= request.time.toMillis() + 300000)
          || (n.hd == 'lichxb' && n.hien == false && n.tu > request.time.toMillis()));
    }
    function doiTV(o, n, nd, q, id) {
      return n.hdMa != o.hdMa && n.hdBoi == myEmail() && n.hdLuc is int && nd.hdMa == n.hdMa && (
        // Ẩn / huỷ lịch: người xuất bản, hoặc người thu hồi duyệt / lưu trữ trong cùng lần ghi
        (n.hd == 'an' && n.hien == false && chiDoi(['hien', 'lyDo']) && shortText(n, 'lyDo', 300)
          && ((nd.hd == 'an' && 'PUBLISH' in q) || (nd.hd == 'thuhoi' && 'REVOKE' in q) || (nd.hd == 'luutru' && 'ARCHIVE' in q)))
        // Đổi phạm vi người xem
        || (n.hd == 'phamvi' && nd.hd == 'phamvi' && chiDoi(['phamVi']) && phamViHopLe(n.phamVi, o.cs) && 'MANAGE_ACCESS' in q)
        );
    }
    // Tới giờ đã hẹn: nhân sự bất kỳ mở web sẽ kích hoạt, nhưng chỉ khi tại đúng lúc này bản vẫn còn được duyệt,
    // chưa lưu trữ và người lên lịch vẫn còn quyền PUBLISH (và MANAGE_ACCESS nếu phạm vi khác mặc định).
    function kichHoat(o, n, nd, id) {
      return n.hdMa != o.hdMa && n.hdBoi == myEmail() && n.hdLuc is int && nd.hdMa == n.hdMa
        && nd.hd == 'kichhoat' && isStaff() && o.hd == 'lichxb' && o.hien == false && n.hien == true
        && request.time.toMillis() >= o.tu && chiDoi(['hien'])
        && nd.duyet != null && nd.duyet.ban == o.ban && nd.luuTru == false
        && kichHoatDuoc(o, quyenCua(o.xbBoi, o.loai, o.dm, o.cs, id));
    }
    function kichHoatDuoc(o, qx) {
      return 'PUBLISH' in qx && (o.phamVi == phamViMacDinh(o.cs) || 'MANAGE_ACCESS' in qx);
    }

    // Thư viện học viên: bản đã xuất bản. Học viên chỉ thấy bản đang hiện, đúng phạm vi cơ sở của mình.
    match /thuvien/{id} {
      allow read: if isAdmin() || isTeacher()
        || (isStudent() && resource.data.hien == true && (resource.data.phamVi == 'tatca'
          || resource.data.phamVi == get(/databases/$(database)/documents/hocvien/$(myEmail())).data.get('coso', '')));
      allow create: if xbTao(request.resource.data, getAfter(/databases/$(database)/documents/noidung/$(id)).data, id);
      allow update: if xbDoi(resource.data, request.resource.data, getAfter(/databases/$(database)/documents/noidung/$(id)).data, id);
      allow delete: if false;
    }
    function xbTao(n, nd, id) {
      return xuatBanTV(null, n, nd, quyenToi(nd.loai, nd.dm, nd.cs, id));
    }
    function xbDoi(o, n, nd, id) {
      return n.hd == 'kichhoat' ? kichHoat(o, n, nd, id) : xbDoiQ(o, n, nd, id, quyenToi(o.loai, o.dm, o.cs, id));
    }
    function xbDoiQ(o, n, nd, id, q) {
      return xuatBanTV(o, n, nd, q) || doiTV(o, n, nd, q, id);
    }

    // ================= THƯ VIỆN VIDEO (tv_video) & EBOOK (tv_ebook) =================
    // Ba yếu tố tách riêng: duyet (phê duyệt) · hienThi (hiển thị) · phamViKieu/phamViKhoa/phamViMail (ai xem).
    // Giáo viên chỉ làm được việc quản lý cấp trong giaovien/<gmail>.quyenTV.<video|ebook>; KHÔNG BAO GIỜ tự duyệt.
    // Đã xuất bản bắt buộc đã duyệt ít nhất một lần (phienDuyet > 0). Sửa bản đã duyệt đi vào banSua, bản cũ giữ nguyên.
    // Mỗi lần ghi tăng v đúng 1: hai quản lý cùng bấm thì người sau bị từ chối, không ghi đè.
    function tvQuyen(loai, k) {
      return isTeacher() && !exists(/databases/$(database)/documents/phanquyen/$(myEmail()))
        && get(/databases/$(database)/documents/giaovien/$(myEmail())).data.get('quyenTV', {}).get(loai, {}).get(k, false) == true;
    }
    function tvQ(loai, act, d, id) {
      return act in quyenToi(loai, d.get('danhMuc','Chung'), d.get('coSo','chung'), id);
    }
    function tvNoiDung() { return ['coSo', 'tieuDe', 'moTa', 'danhMuc', 'link', 'anh', 'thoiLuong', 'pdf', 'ytId']; }
    function tvLinkDung(loai, link) {
      return link is string && link.size() <= 500 && (loai == 'video'
        ? link.matches('^https://(www[.])?(youtube[.]com/watch[?]v=|youtu[.]be/)[A-Za-z0-9_-]{11}$')
        : link.matches('^https://www[.]canva[.]com/design/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/view$'));
    }
    function tvNdHopLe(loai, d) {
      return d.tieuDe is string && d.tieuDe.size() > 0 && d.tieuDe.size() <= 150
        && shortText(d, 'moTa', 1000) && shortText(d, 'danhMuc', 80) && shortText(d, 'thoiLuong', 20)
        && tvLinkDung(loai, d.link)
        && (!('anh' in d) || d.anh == '' || (d.anh is string && d.anh.size() <= 500 && d.anh.matches('^https://[^ "<>]+$')))
        && (!('pdf' in d) || d.pdf == '' || (d.pdf is string && d.pdf.size() <= 500 && d.pdf.matches('^https://[^ "<>]+$')))
        && (loai == 'ebook' || (d.ytId is string && d.link.matches('.*' + d.ytId + '$')));
    }
    function tvHopLe(loai, d) {
      return d.keys().hasOnly(tvNoiDung().concat(['thuTu', 'duyet', 'hienThi', 'phamViKieu', 'phamViKhoa', 'phamViMail', 'phienDuyet', 'banSua', 'lyDo',
          'xbPhien', 'nguoiTao', 'nguoiSoan', 'tenNguoiTao', 'tao', 'guiLuc', 'xuLyBoi', 'xuLyLuc', 'lichXuatBan', 'capNhat', 'v']))
        && tvNdHopLe(loai, d)
        && (d.banSua == null || (d.banSua is map && d.banSua.keys().hasOnly(tvNoiDung()) && tvNdHopLe(loai, d.banSua)))
        && d.duyet in ['nhap', 'cho', 'sua', 'daduyet', 'tuchoi']
        && d.hienThi in ['chua', 'xuatban', 'an', 'luutru']
        && d.phamViKieu in ['congkhai', 'hocvien', 'khoa', 'taikhoan']
        && d.phamViKhoa is list && d.phamViKhoa.size() <= 50 && d.phamViMail is list && d.phamViMail.size() <= 50
        && d.phienDuyet is int && d.v is int && d.thuTu is number
        && shortText(d, 'lyDo', 500)
        && (d.hienThi != 'xuatban' || d.phienDuyet > 0);
    }
    function tvDoc(loai,id) {
      return isAdmin() || (isTeacher() && (tvQ(loai,'VIEW',resource.data,id) || resource.data.nguoiTao == myEmail()
        || (!exists(/databases/$(database)/documents/phanquyen/$(myEmail())) && resource.data.hienThi == 'xuatban')));
    }
    function tvList(loai,id) {
      return isTeacher()
        && (exists(/databases/$(database)/documents/phanquyen/$(myEmail()))
          && 'VIEW' in dsQ(pqCua(myEmail()),loai,resource.data.danhMuc,resource.data.coSo,{})
          && (pqCua(myEmail()).get('camXem',[]).size() == 0 || !(id in pqCua(myEmail()).get('camXem',[]))));
    }
    function tvNhapMau(d,id) {
      let mau = {"vZdFuUTUeJw":"Chân dung tham khảo 01","kcsVYarOj3Q":"Chân dung tham khảo 02","0ugijncV044":"Chân dung tham khảo 03","F0gvbmmmBks":"Chân dung tham khảo 04","wAzToQzLvsI":"Chân dung tham khảo 05","zawPgE4fVyw":"Chân dung tham khảo 06","1n_FuJRkL5E":"Chân dung tham khảo 07","E1liPpUFsNE":"Chân dung tham khảo 08","dtsrRKw5mVI":"Chân dung tham khảo 09","MyBXfdEDKXw":"Chân dung tham khảo 10","bzmE8cv2mGY":"Chân dung tham khảo 11","jvsmtqpkUtA":"Chân dung tham khảo 12","mn4sFkA0Z40":"Chân dung tham khảo 13","g4bWjq8EGlk":"Chân dung tham khảo 14","VJYjfK-1_uA":"Chân dung tham khảo 15","E7_4OQaNIUI":"Chân dung tham khảo 16","rmx5PwAQvMw":"Chân dung tham khảo 17"};
      return isAdmin() && id == 'yt-' + d.ytId && d.ytId in mau && d.tieuDe == mau[d.ytId]
        && d.link == 'https://youtu.be/' + d.ytId && d.duyet == 'daduyet' && d.hienThi == 'xuatban'
        && d.phienDuyet == 1 && d.banSua == null && d.get('xbPhien',0) == 1;
    }
    function tvTao(loai, id) {
      let d = request.resource.data;
      return tvHopLe(loai, d) && d.v == 1 && d.nguoiTao == myEmail()
        && d.get('nguoiSoan',[myEmail()]) == [myEmail()]
        && (tvQ(loai,'CREATE',d,id) || tvQuyen(loai,'them'))
        && ((d.duyet in ['nhap','cho'] && d.hienThi == 'chua' && d.phienDuyet == 0 && d.banSua == null
          && d.phamViKieu == 'hocvien' && d.phamViKhoa.size() == 0 && d.phamViMail.size() == 0 && d.xuLyBoi == '' && d.lyDo == '')
          || (loai == 'video' && tvNhapMau(d,id)));
    }
    function tvEdit(loai,q,d,cu,doi) {
      let owner = cu.nguoiTao == myEmail();
      let editors = cu.get('nguoiSoan',[cu.nguoiTao]);
      let changed = doi.hasAny(tvNoiDung().concat(['banSua']));
      let people = d.get('nguoiSoan',[d.nguoiTao]);
      let legacy = isTeacher() && !exists(/databases/$(database)/documents/phanquyen/$(myEmail())) ? get(/databases/$(database)/documents/giaovien/$(myEmail())).data.get('quyenTV',{}).get(loai,{}) : {};
      return ('EDIT' in q || (owner && 'CREATE' in q) || legacy.get('sua',false) || (owner && legacy.get('them',false)))
        && cu.hienThi != 'luutru'
        && doi.hasOnly(tvNoiDung().concat(['duyet','banSua','guiLuc','lyDo','nguoiSoan','capNhat','v']))
        && d.duyet in ['nhap','cho','sua','tuchoi'] && (!doi.hasAny(['lyDo']) || d.lyDo == '')
        && (cu.phienDuyet == 0 || !doi.hasAny(tvNoiDung()))
        && (changed ? people.hasAny([myEmail()]) && people.hasAll(cu.duyet == 'daduyet' ? [] : editors)
             && people.hasOnly((cu.duyet == 'daduyet' ? [] : editors).concat([myEmail()])) : people == editors)
        && ('SOURCE' in q || (cu.phienDuyet == 0 && owner && 'CREATE' in q) || legacy.get('them',false) ||
            (d.link == cu.link && (d.banSua == null || d.banSua.link == (cu.banSua == null ? cu.link : cu.banSua.link))));
    }
    function tvApprove(q,d,cu,doi) {
      let metadata = ['xuLyBoi','xuLyLuc','capNhat','v'];
      return 'APPROVE' in q && cu.duyet == 'cho' && cu.hienThi != 'luutru' && !(myEmail() in cu.get('nguoiSoan',[cu.nguoiTao]))
        && d.xuLyBoi == myEmail() && (d.duyet == 'daduyet'
          ? d.phienDuyet == cu.phienDuyet + 1 && d.banSua == null && d.lyDo == ''
            && doi.hasOnly(tvNoiDung().concat(['duyet','phienDuyet','banSua','lyDo']).concat(metadata))
            && (cu.banSua == null ? !doi.hasAny(tvNoiDung()) :
              d.tieuDe == cu.banSua.tieuDe && d.moTa == cu.banSua.get('moTa','') && d.link == cu.banSua.link
              && d.danhMuc == cu.banSua.get('danhMuc','') && d.get('anh','') == cu.banSua.get('anh','')
              && d.get('pdf','') == cu.banSua.get('pdf','') && d.get('thoiLuong','') == cu.banSua.get('thoiLuong','') && d.get('ytId','') == cu.banSua.get('ytId',''))
          : d.duyet in ['sua','tuchoi'] && d.lyDo.size() > 0 && doi.hasOnly(['duyet','lyDo'].concat(metadata)));
    }
    function tvPubHidden(loai,id) {
      return loai == 'video' ? !existsAfter(/databases/$(database)/documents/tv_video_public/$(id))
        : !existsAfter(/databases/$(database)/documents/tv_ebook_public/$(id));
    }
    function tvScopeSync(loai,id,d) {
      let pub = loai == 'video' ? getAfter(/databases/$(database)/documents/tv_video_public/$(id)).data
        : getAfter(/databases/$(database)/documents/tv_ebook_public/$(id)).data;
      return pub.phamViKieu == d.phamViKieu && pub.phamViKhoa == d.phamViKhoa && pub.phamViMail == d.phamViMail;
    }
    function tvVisibility(loai,id,q,d,cu,doi) {
      let metadata=['xuLyBoi','xuLyLuc','capNhat','v'];
      return d.xuLyBoi == myEmail() && (d.hienThi == 'xuatban'
        ? 'PUBLISH' in q && cu.phienDuyet > 0 && cu.duyet == 'daduyet' && cu.hienThi in ['chua','an','xuatban']
          && doi.hasOnly(['hienThi','lichXuatBan','xbPhien'].concat(metadata))
          && d.get('xbPhien',0) == cu.phienDuyet && !tvPubHidden(loai,id)
        : tvPubHidden(loai,id) && (d.hienThi == 'an'
          ? ('PUBLISH' in q || tvQuyen(loai,'an')) && cu.hienThi == 'xuatban' && doi.hasOnly(['hienThi'].concat(metadata))
          : d.hienThi == 'luutru'
            ? 'ARCHIVE' in q && cu.hienThi != 'luutru' && doi.hasOnly(['hienThi'].concat(metadata))
            : (cu.hienThi == 'luutru' ? 'RESTORE' in q && d.hienThi == 'chua' && doi.hasOnly(['hienThi'].concat(metadata))
              : 'REVOKE' in q && cu.phienDuyet > 0 && d.duyet == 'cho' && d.hienThi == 'chua' && doi.hasOnly(['duyet','hienThi'].concat(metadata)))));
    }
    function tvSua(loai,id) {
      let d=request.resource.data;
      let cu=resource.data;
      let doi=d.diff(cu).affectedKeys();
      let q=quyenToi(loai,cu.get('danhMuc','Chung'),cu.get('coSo','chung'),id);
      return tvHopLe(loai,d) && d.v == cu.v + 1 && d.nguoiTao == cu.nguoiTao && d.tao == cu.tao
        && d.get('coSo','chung') == cu.get('coSo','chung')
        && (doi.hasAny(['hienThi','lichXuatBan','xbPhien']) ? tvVisibility(loai,id,q,d,cu,doi)
          : doi.hasAny(['phienDuyet']) || (doi.hasAny(['duyet']) && d.duyet in ['sua','tuchoi']) ? tvApprove(q,d,cu,doi)
          : doi.hasAny(['phamViKieu','phamViKhoa','phamViMail']) ? 'MANAGE_ACCESS' in q && d.xuLyBoi == myEmail()
            && (cu.hienThi != 'xuatban' || tvScopeSync(loai,id,d))
            && doi.hasOnly(['phamViKieu','phamViKhoa','phamViMail','xuLyBoi','xuLyLuc','capNhat','v'])
          : doi.hasAny(['thuTu']) ? ('EDIT' in q || tvQuyen(loai,'sapXep')) && doi.hasOnly(['thuTu','capNhat','v'])
          : tvEdit(loai,q,d,cu,doi));
    }
    match /tv_video/{id} {
      allow get: if tvDoc('video', id);
      allow list: if tvList('video', id);
      allow list: if isAdmin();
      allow list: if isTeacher() && resource.data.nguoiTao == myEmail();
      allow list: if isTeacher() && !exists(/databases/$(database)/documents/phanquyen/$(myEmail())) && resource.data.hienThi == 'xuatban';
      allow create: if tvTao('video', id);
      allow update: if tvSua('video', id);
      allow delete: if tvQ('video','DELETE',resource.data,id) && resource.data.hienThi == 'luutru';
    }
    match /tv_ebook/{id} {
      allow get: if tvDoc('ebook', id);
      allow list: if tvList('ebook', id);
      allow list: if isAdmin();
      allow list: if isTeacher() && resource.data.nguoiTao == myEmail();
      allow list: if isTeacher() && !exists(/databases/$(database)/documents/phanquyen/$(myEmail())) && resource.data.hienThi == 'xuatban';
      allow create: if tvTao('ebook', id);
      allow update: if tvSua('ebook', id);
      allow delete: if tvQ('ebook','DELETE',resource.data,id) && resource.data.hienThi == 'luutru';
    }
    // Học viên chỉ đọc bản sao đã xuất bản; không thể tải bản sửa chưa được duyệt.
    function tvPublicRead() {
      let d = resource.data;
      return isStaff() || (d.hienThi == 'xuatban' && d.lichXuatBan <= request.time.toMillis() && (
        d.phamViKieu == 'congkhai'
        || (d.phamViKieu == 'hocvien' && isStudent())
        || (d.phamViKieu == 'khoa' && isStudent() && d.phamViKhoa.hasAny(get(/databases/$(database)/documents/hocvien/$(myEmail())).data.get('khoaHoc',[])))
        || (d.phamViKieu == 'taikhoan' && signedIn() && myEmail() in d.phamViMail)));
    }
    function tvPublicWrite(loai,id,col) {
      let d = getAfter(/databases/$(database)/documents/$(col)/$(id)).data;
      return request.resource.data == {'coSo': d.get('coSo','chung'),'tieuDe': d.get('tieuDe',''),'moTa': d.get('moTa',''),'danhMuc': d.get('danhMuc',''),'link': d.get('link',''),'anh': d.get('anh',''),'thoiLuong': d.get('thoiLuong',''),'pdf': d.get('pdf',''),'ytId': d.get('ytId',''),'thuTu': d.get('thuTu',''),'hienThi': d.get('hienThi',''),'phienDuyet': d.get('phienDuyet',''),'phamViKieu': d.get('phamViKieu',''),'phamViKhoa': d.get('phamViKhoa',''),'phamViMail': d.get('phamViMail',''),'lichXuatBan': d.get('lichXuatBan',0)} && d.hienThi == 'xuatban' && d.phienDuyet > 0
        && ((tvQ(loai,'PUBLISH',d,id) && d.duyet == 'daduyet' && d.get('xbPhien',0) == d.phienDuyet)
            || (loai == 'video' && tvNhapMau(d,id)));
    }
    function tvPublicScope(loai,id,col) {
      let d = getAfter(/databases/$(database)/documents/$(col)/$(id)).data;
      return tvQ(loai,'MANAGE_ACCESS',d,id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phamViKieu','phamViKhoa','phamViMail'])
        && request.resource.data.phamViKieu == d.phamViKieu && request.resource.data.phamViKhoa == d.phamViKhoa && request.resource.data.phamViMail == d.phamViMail;
    }
    function tvPublicDelete(loai,id,col) {
      let d = getAfter(/databases/$(database)/documents/$(col)/$(id)).data;
      return d.hienThi != 'xuatban' && (tvQ(loai,'PUBLISH',d,id) || tvQ(loai,'ARCHIVE',d,id) || tvQ(loai,'REVOKE',d,id) || tvQuyen(loai,'an'));
    }
    match /tv_video_public/{id} {
      allow read: if tvPublicRead();
      allow create: if tvPublicWrite('video',id,'tv_video');
      allow update: if tvPublicWrite('video',id,'tv_video') || tvPublicScope('video',id,'tv_video');
      allow delete: if tvPublicDelete('video',id,'tv_video');
    }
    match /tv_ebook_public/{id} {
      allow read: if tvPublicRead();
      allow create: if tvPublicWrite('ebook',id,'tv_ebook');
      allow update: if tvPublicWrite('ebook',id,'tv_ebook') || tvPublicScope('ebook',id,'tv_ebook');
      allow delete: if tvPublicDelete('ebook',id,'tv_ebook');
    }
    // Danh mục + cờ "đã nạp 17 video có sẵn": ai cũng đọc; quản lý hoặc giáo viên có quyền danh mục sửa.
    match /tv_meta/{loai} {
      allow read: if true;
      allow write: if loai in ['video', 'ebook'] && (isAdmin() || (tvQuyen(loai, 'danhMuc') && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['danhMuc'])))
        && (!('danhMuc' in request.resource.data) || (request.resource.data.danhMuc is list && request.resource.data.danhMuc.size() <= 60));
    }
    // Lịch sử thao tác: ghi đúng tên mình, không sửa / xoá được. Quản lý đọc tất cả, giáo viên đọc thao tác của mình.
    match /tv_lichsu/{id} {
      allow read: if isAdmin() || (isTeacher() && resource.data.ai == myEmail());
      allow create: if isStaff() && request.resource.data.ai == myEmail() && request.resource.data.thuVien in ['video', 'ebook']
        && request.resource.data.keys().hasOnly(['thuVien', 'ma', 'hanhDong', 'tu', 'den', 'tieuDe', 'lyDo', 'ai', 'luc'])
        && shortText(request.resource.data, 'lyDo', 500) && shortText(request.resource.data, 'tieuDe', 150);
      allow update, delete: if false;
    }
    // Tiến độ xem video / đọc ebook: học viên ghi của mình; giáo viên, quản lý xem để thống kê.
    match /tv_tiendo/{mail} {
      allow read: if isStaff() || isMe(mail);
      allow write: if isStudent() && isMe(mail) && request.resource.data.keys().hasOnly(['video', 'ebook', 'capNhat']);
    }

    match /admins/{mail} {
      allow read: if isMe(mail);
      allow write: if false;
    }
  }
}
